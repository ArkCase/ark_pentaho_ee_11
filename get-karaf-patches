#!/usr/bin/env python3

# Consumes a Trivy JSON report and writes ONE YAML patch file that
# apply-karaf-patches consumes during the container build.
#
# SCOPE: only bundles in karaf system repos. Everything outside karaf (lib dirs,
# webapps, plugin folders) is ignored entirely and handled by other means.
#
# Nothing is specific to one report, image, project or library: karaf instances,
# the bundles that belong together and the version they move to are all worked out
# from the report and the analysed tree.
#
#   ./get-karaf-patches <vulnerabilities.json> <root> [--out karaf-patches.yaml]
#                          [--levels HIGH,CRIT] [--no-osgi-check] [--no-osgi-fail]
#
#   <vulnerabilities.json>  the Trivy report. Produced by scan.sh, or assembled
#                           and committed by hand - either is fine. Nothing is
#                           auto-discovered: the file is always a parameter.
#   <root>                  path to the container filesystem that is analysed
#                           (karaf instances, manifests, feature pins). It is NOT
#                           recorded: paths in the output are relative to it.
#   --levels LIST         severity levels recorded for apply-karaf-patches (default
#                           HIGH,CRIT). CRIT/CRITICAL, HIGH, MED/MEDIUM, LOW,
#                           UNK/UNKNOWN, ALL.
#   --no-osgi-fail        report OSGi violations as warnings instead of exiting 1.
#                           Default: fail. Nothing is recorded: the applier fails on a
#                           violation unless it is given --no-osgi-fail too.
#   --no-osgi-check       skip the OSGi import-package check. It runs BY DEFAULT: for
#                           every group, walk the consumers in its karaf repo, check
#                           each Import-Package range against the package version that
#                           would be exported AFTER the whole group moves, and disable
#                           a group whose move would break a consumer. Exits 1 when
#                           that is the only thing keeping a group from applying.
#
# Output layout (plain block YAML, hand-editable):
#   settings:  what the applier reads: levels
#   header:    provenance: sha256 of the source report and the scanned image
#   groups:    one entry per unit of work, named for what it moves. `apply` is the
#              only switch and is all-or-nothing; `severity` is the highest severity
#              the group addresses and is what --levels filters on; `summary` maps
#              each replacement artifact (Maven coordinate in mvn-get's order,
#              groupId:artifactId:version[:type[:classifier]]) to the paths of the jars
#              it replaces, relative to the filesystem root - informative, for review
#              at a glance (it repeats what the patches say); `note` says why a group is disabled by
#              default, and names related repackaged copies that cannot move with it.
#   patches:   what to do, one entry per bundle and karaf instance: `patch-group`
#              names its group, `method` says how it is applied (karaf: seed the
#              bundle into the karaf repo and add a bundleReplacement), `karaf` is
#              the karaf home it lives in, then coordinates, current and target
#              version, and the bundleReplacement to write.
#
# Nothing is downloaded here: the applier fetches the target jars at build time.
#
# Rules:
#   - coordinates (groupId, artifactId, version) come only from the report:
#     `Vulnerabilities` for what is vulnerable and what fixes each CVE, `Packages`
#     for every bundle. Jars are opened only for OSGi manifests.
#   - a karaf instance is found, not configured: a report path is a karaf bundle when
#     it sits at <home>/system/<Maven layout of its own coordinates> and
#     <home>/etc/org.apache.karaf.features.cfg exists in the analysed tree.
#   - two groupIds belong to one project when they are equal or share at least
#     MIN_SHARED_SEGMENTS leading segments (a.b.c.x and a.b.c.y); sharing only an
#     organisation prefix (org.apache) does not count.
#   - a release is found by linking bundles that (a) have the same version and
#     related groupIds - released together - (b) are copies of the same
#     groupId:artifactId on the same major - a bundle patched in one place is
#     patched everywhere - or (c) are in a family: a release spanning two or more
#     related groupIds marks those groupIds as one family, and every bundle in one
#     of them on the same major moves in lockstep. Links are followed transitively.
#     Artifact names play no part. Stated limit: two unrelated projects under one deep prefix that happen to
#     share a version string are linked.
#   - target, per release: its vulnerable members are taken by installed
#     major.minor. When every CVE of such a line has a fix on that major.minor, the
#     LATEST fix offered there (a patch move); otherwise the lowest same-major minor
#     at which every CVE is fixed, at the latest fix offered on it (a minor move);
#     when no fix exists on the installed major, the lowest higher major where every
#     CVE is fixed, picked the same way (a major move). The release moves to the
#     highest of its lines' targets. Only patch moves are enabled by default.
#   - releases of related groupIds that land on the same target are one group.
#   - a member with no CVE of its own whose version jump is larger than the
#     vulnerable members' (it sits on an older minor or major) goes to a group of
#     its own, named <group>-<major.minor>, disabled by default, with the parent's
#     severity. Vulnerable members are never split off: they move together.
#   - group names: the last segment of the members' shared groupId prefix, or the
#     artifactId when the group holds one artifact; a clash appends the target.
#   - findings with no fix, no single major fixing every CVE, or not at their Maven
#     location are printed as unpatchable. A related bundle inside a karaf repo but
#     not at its Maven location (repackaged or renamed) is named in the group's note:
#     it cannot be swapped and stays on its version.

import argparse
import hashlib
import os
import re
import sys
import zipfile
from collections import defaultdict

sys.dont_write_bytecode = True     # no __pycache__ next to the scripts
from patchgen import (DEFAULT_LEVELS, SEV_RANK, base_notes, coordinate, gav, plan, read_report,  # noqa: E402
                      add_vuln, stuck_copies, tidy, vstr, vtuple, yaml_dump)


def layout(g, a, v):
    """Where a bundle sits in a karaf system repo (Maven layout), relative to the karaf home."""
    return 'system/%s/%s/%s/%s-%s.jar' % (g.replace('.', '/'), a, v, a, v)


def manifest(jar_path):
    try:
        with zipfile.ZipFile(jar_path) as z:
            raw = z.read('META-INF/MANIFEST.MF').decode('utf-8', 'replace')
    except Exception:
        return None
    lines = []
    for line in raw.replace('\r\n', '\n').replace('\r', '\n').split('\n'):
        if line.startswith(' '):          # continuation line (72-char folding)
            if lines:
                lines[-1] += line[1:]
        elif line:
            lines.append(line)
    return dict((l.split(':', 1)[0], l.split(':', 1)[1].strip()) for l in lines if ':' in l)


def clauses(s):
    # OSGi header clauses are comma-separated, but version ranges [a,b) contain
    # commas themselves; split only outside the brackets.
    out, cur, inb = [], '', False
    for ch in s:
        if ch == '[': inb = True
        elif ch == ']': inb = False
        if ch == ',' and not inb:
            if cur.strip(): out.append(cur.strip())
            cur = ''
        else:
            cur += ch
    if cur.strip(): out.append(cur.strip())
    return out


def parse_range(rng):
    if not rng:
        return None
    m = re.match(r'^\[(.+?),(.+?)([)\]])$', rng)
    if m:
        return (vtuple(m.group(1)), vtuple(m.group(2)), m.group(3) == ']')
    return (vtuple(rng), None, False)


def satisfies(rng, ver):
    p = parse_range(rng)
    if p is None:
        return True
    lo, hi, closed = p
    v = vtuple(ver)
    if lo and v < lo:
        return False
    if hi and (v > hi or (v == hi and not closed)):
        return False
    return True


def export_versions(man):
    ver = man.get('Bundle-Version', '0')
    out = {}
    for clause in clauses(man.get('Export-Package') or ''):
        pkg = clause.split(';')[0].strip()
        m = re.search(r'version="([^"]+)"', clause)
        out[pkg] = m.group(1) if m else ver
    return out


def imports_of(man):
    out = []
    for c in clauses(man.get('Import-Package', '')):
        pkg = c.split(';')[0]
        m = re.search(r'version="([^"]+)"', c)
        out.append((pkg, m.group(1) if m else None))
    return out


TOP_COMMENT = """\
Karaf patch list for apply-karaf-patches. Generated by get-karaf-patches; commit
it, review it, edit it by hand. Only bundles in karaf's system repo are covered.

groups    one entry per unit of work. `apply` is the only switch, all-or-nothing:
          true applies every patch of the group, false applies none. `summary`
          must match the group's patches (the applier refuses a stale summary).
patches   one entry per bundle. Moving a bundle to another group is a matter of
          changing its `patch-group` (and the two summaries): a group moves to one
          target, so its patches must all share it."""


def main():
    ap = argparse.ArgumentParser(description='Turn a Trivy JSON scan into a committed YAML patch list for karaf.')
    ap.add_argument('input', help='path to the Trivy JSON report (no default - must be given)')
    ap.add_argument('root', help='path of the container filesystem that is analysed; not recorded in the output file')
    ap.add_argument('--out', default='karaf-patches.yaml', help='output patch file')
    ap.add_argument('--levels', default=DEFAULT_LEVELS,
                    help='severity levels the applier should patch (recorded in settings.levels; '
                         'HIGH/CRIT or CRITICAL, MED or MEDIUM, LOW, UNK or UNKNOWN, ALL)')
    ap.add_argument('--no-osgi-check', action='store_true', dest='no_osgi_check',
                    help='skip the OSGi import-package check; it runs by default')
    ap.add_argument('--no-osgi-fail', action='store_true', dest='no_osgi_fail',
                    help='warn on OSGi violations instead of exiting 1; nothing is recorded, '
                         'so the applier still fails by default')
    args = ap.parse_args()

    report, entries = read_report(args.input)
    root = os.path.normpath(args.root)

    # ---- karaf instances are discovered, not configured: a report path is a karaf
    #      bundle when it sits at <home>/system/<Maven layout of its own coordinates>
    #      and <home>/etc/org.apache.karaf.features.cfg exists in the analysed tree ----
    is_karaf_cache = {}

    def is_karaf(home):
        if home not in is_karaf_cache:
            is_karaf_cache[home] = os.path.isfile(os.path.join(root, home, 'etc', 'org.apache.karaf.features.cfg'))
        return is_karaf_cache[home]

    def karaf_home_of(path, k):
        p, suf = os.path.normpath(path), layout(*k)
        if p == suf:
            home = '.'
        elif p.endswith('/' + suf):
            home = p[:-len(suf) - 1]
        else:
            return None
        return home if is_karaf(home) else None

    homes_of = defaultdict(set)    # (g, a, v) -> karaf homes holding it at its Maven location
    for k, path, _, _ in entries:
        home = karaf_home_of(path, k)
        if home:
            homes_of[k].add(home)
    homes = sorted({h for hs in homes_of.values() for h in hs})

    def in_a_karaf_repo(path):
        p = os.path.normpath(path)
        return any(p.startswith(os.path.normpath(os.path.join(h, 'system')) + '/') for h in homes)

    vulns = {}                     # (g, a, v) -> {'cves': {id: {'fixes', 'severity'}}}
    elsewhere = defaultdict(set)   # (g, a, v) -> paths inside a karaf repo that are NOT its Maven location
    unpatchable = set()
    for k, path, v, _ in entries:
        at_home = karaf_home_of(path, k)
        if not at_home:
            if in_a_karaf_repo(path):
                if v is not None:
                    unpatchable.add('%s at %s - not at its Maven repo location (inside another jar or '
                                    'renamed); a bundle swap cannot address it' % (gav(k), path))
                else:
                    elsewhere[k].add(path)
            continue                    # outside karaf: out of scope
        if v is not None:
            add_vuln(vulns, k, v)

    # ---- per karaf home: OSGi consumers, feature pins, existing processing file ----
    consumers, feature_text, processing_text = defaultdict(list), {}, {}
    for h in homes:
        system = os.path.join(root, h, 'system')
        texts = []
        for dirpath, _, files in os.walk(system):
            for f in files:
                full = os.path.normpath(os.path.join(dirpath, f))
                if f.endswith('.xml'):
                    texts.append(open(full, errors='replace').read())
                if not f.endswith('.jar'):
                    continue
                man = manifest(full)
                if not man:
                    continue
                bsn = man.get('Bundle-SymbolicName', '').split(';')[0]
                for pkg, rng in imports_of(man):
                    consumers[h].append((bsn, pkg, rng, full))
        feature_text[h] = '\n'.join(texts)
        pf = os.path.join(root, h, 'etc', 'org.apache.karaf.features.xml')
        processing_text[h] = open(pf).read() if os.path.exists(pf) else ''

    pin_re = lambda g, a: re.compile(r'mvn:%s/%s/([0-9][^/<]*)(?:/([a-zA-Z][^/>]*))?' % (re.escape(g), re.escape(a)))

    def processing_block(h, group, artifact, target):
        pins = set(pin_re(group, artifact).findall(feature_text[h]))
        classifier = next((c for _, c in sorted(pins) if c), None)
        ex = re.search(r'originalUri="mvn:%s/%s/\[([^],]+),([^)\]]+)\)"' % (re.escape(group), re.escape(artifact)),
                       processing_text[h])
        lo = vtuple(ex.group(1)) if ex else min((vtuple(p) for p, _ in pins), default=(0,))
        suffix = ('/' + classifier) if classifier else ''
        return tidy({
            'action': 'extend' if ex else 'add',
            'existing_originalUri': 'mvn:%s/%s/[%s,%s)' % (group, artifact, ex.group(1), ex.group(2)) if ex else None,
            'originalUri': 'mvn:%s/%s/[%s,%s)%s' % (group, artifact, vstr(lo), target, suffix),
            'replacement': 'mvn:%s/%s/%s%s' % (group, artifact, target, suffix),
            'mode': 'maven',
            'classifier': classifier,
        })

    def bundle_info(jar_abs, group, artifact):
        man = manifest(jar_abs) if os.path.exists(jar_abs) else None
        bsn = man.get('Bundle-SymbolicName', '').split(';')[0].strip() if man else ''
        norm = artifact.replace('-', '')
        native = bsn and (norm in bsn.replace('.', '').replace('-', '') or bsn.startswith(group))
        return bsn, bool(bsn) and not native

    def osgi_predict(moving, target):
        """moving: [(home, jar_abs, wrapped)] that all move to target together.
        Consumers that are themselves moving are skipped: they move with the group
        and are re-checked against their fetched manifests by the applier."""
        if args.no_osgi_check:
            return {'status': 'skipped', 'violations': []}
        skip = {j for _, j, _ in moving}
        viol, checked = [], 0
        for h, jar, wrapped in moving:
            man = manifest(jar) if os.path.exists(jar) else None
            mine = export_versions(man) if man else {}
            for cb, pkg, rng, cp in consumers[h]:
                if pkg not in mine or cp in skip:     # OSGi ignores self-imports
                    continue
                checked += 1
                before = mine[pkg]
                after = before if wrapped else target  # rewrap preserves Export-Package verbatim
                if not satisfies(rng, after) and satisfies(rng, before):
                    viol.append('%s imports %s %s; exported %s before, %s after' % (cb, pkg, rng, before, after))
        return {'status': 'fail' if viol else 'pass', 'checked': checked, 'violations': viol}

    plan_groups, already = plan(homes_of, vulns, unpatchable)

    # ---- build groups and patches ----
    group_rows = []                # (sort key, name, group, patches, chk, gjump, split parent)
    for pg in plan_groups:
        name, target, keys, sev = pg['name'], pg['target'], pg['members'], pg['severity']
        patches, moving, summary = [], [], defaultdict(list)
        for k in keys:
            g, a, v = k
            for h in sorted(homes_of[k]):
                jar_rel = os.path.normpath(os.path.join(h, layout(*k)))
                bsn, wrapped = bundle_info(os.path.join(root, jar_rel), g, a)
                moving.append((h, os.path.join(root, jar_rel), wrapped))
                pr = processing_block(h, g, a, target)
                patches.append(tidy({'patch-group': name, 'method': 'karaf', 'karaf': h, 'groupId': g,
                                     'artifactId': a, 'current': v, 'target': target,
                                     'symbolic_name': bsn or None, 'processing': pr}))
                summary[coordinate(g, a, target, pr.get('classifier'))].append(jar_rel)
        chk = osgi_predict(moving, target)
        notes = base_notes(pg)
        if chk['status'] == 'fail':
            notes.append('import-range violation introduced by the move')
        # related bundles inside a karaf repo but not at their Maven location (repackaged
        # or renamed): they cannot be swapped and stay on their version
        stuck = stuck_copies(pg, elsewhere)
        left = ['repackaged copies cannot be swapped and stay on their version: %s' % ', '.join(stuck)] if stuck else []
        group = tidy({'apply': not notes, 'severity': sev, 'note': '; '.join(notes + left) or None,
                      'summary': {c: sorted(ps) for c, ps in sorted(summary.items())}})
        group_rows.append(((-SEV_RANK.get(sev, 0), name), name, group, patches, chk, pg['gjump'], pg['split_of']))

    group_rows.sort(key=lambda r: r[0])
    groups = {r[1]: r[2] for r in group_rows}
    patches = [p for r in group_rows for p in r[3]]

    header = {'source_sha256': hashlib.sha256(open(args.input, 'rb').read()).hexdigest(),
              'scan_artifact': report.get('ArtifactName')}
    settings = {'levels': args.levels}           # severity levels the applier patches
    open(args.out, 'w').write(yaml_dump({'settings': settings, 'header': header, 'groups': groups,
                                         'patches': patches}, TOP_COMMENT))

    on = [r for r in group_rows if r[2]['apply']]
    print('karaf       : %s' % (', '.join(homes) if homes else 'no karaf instance found in the report and tree'))
    print('groups      : %d (%d apply, %d disabled), %d patches'
          % (len(group_rows), len(on), len(group_rows) - len(on), len(patches)))
    print('levels      : %s' % args.levels)
    print('root        : %s (analysis only - not recorded)' % root)
    for k, t in already:
        print('  SKIP %s already at or above the fix %s' % (gav(k), t))
    for r in group_rows:
        if not r[2]['apply']:
            print('REVIEW %s -> %s [%s] %s: %s' % (r[1], r[3][0]['target'], r[5], r[2].get('severity') or '-',
                                                 r[2].get('note', '')))
    for x in sorted(unpatchable):
        print('UNPATCHABLE %s' % x)
    if args.no_osgi_check:
        print('osgi check skipped: karaf moves are recorded unproven')
        return
    # exit 1 only when the OSGi check alone is what keeps a group from applying
    fails = [r for r in group_rows if r[4]['status'] == 'fail' and r[5] == 'patch' and not r[6]]
    for r in group_rows:
        if r[4]['status'] == 'fail':
            print('%s %s -> %s : %s'
                  % ('OSGI CHECK FAIL' if r in fails and not args.no_osgi_fail else 'OSGI CHECK WARN' if r in fails
                     else 'OSGI (group already disabled)', r[1], r[3][0]['target'], '; '.join(r[4]['violations'])))
    if fails and not args.no_osgi_fail:
        sys.exit(1)


if __name__ == '__main__':
    main()

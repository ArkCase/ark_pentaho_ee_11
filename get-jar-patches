#!/usr/bin/env python3

# Consumes a Trivy JSON report and writes ONE YAML patch file for plain jars:
# everything that is NOT karaf. Its companion get-karaf-patches covers karaf.
#
# SCOPE: jars replaced in place (web applications, application-server lib dirs,
# plain classpath and plugin lib dirs). TEMPORARY rule: every path containing
# "/karaf/" is ignored, until a general karaf/non-karaf test replaces it.
#
# Nothing is specific to one report, image, project or library: the jars that
# belong together and the version they move to are worked out from the report.
#
#   ./get-jar-patches <vulnerabilities.json> <root> [--out patches.yaml] [--levels HIGH,CRIT]
#
#   <vulnerabilities.json>  the Trivy report. Produced by scan.sh, or assembled
#                           and committed by hand - either is fine. Nothing is
#                           auto-discovered: the file is always a parameter.
#   <root>                  path to the container filesystem the report describes.
#                           Only used to check that each jar is really there; NOT
#                           recorded: paths in the output are relative to it.
#   --levels LIST         severity levels recorded for the patching step (default
#                           HIGH,CRIT). CRIT/CRITICAL, HIGH, MED/MEDIUM, LOW,
#                           UNK/UNKNOWN, ALL.
#
# Output layout (plain block YAML, hand-editable):
#   settings:  levels
#   header:    provenance: sha256 of the source report and the scanned image
#   groups:    one entry per unit of work, named for what it moves. `apply` is the
#              only switch and is all-or-nothing; `severity` is the highest severity
#              the group addresses; `summary` maps each replacement artifact (Maven
#              coordinate in mvn-get's order, groupId:artifactId:version[:type[:classifier]])
#              to the paths of the jars it replaces, relative to the filesystem root -
#              informative, for review at a glance (it repeats what the patches say);
#              `note` says why a group is disabled by default.
#   patches:   one entry per artifact version: `patch-group` names its group,
#              `method: direct` (replace the file in place), coordinates (with
#              `classifier`/`type` when the report's PURL carries them), current and
#              target version, and `paths` - every copy of that jar, all replaced.
#
# Rules (shared with get-karaf-patches, see patchgen.py):
#   - coordinates (groupId, artifactId, version) come only from the report.
#   - a file is a replacement candidate when the report names exactly one artifact
#     for it, whatever the file is called: the scanner identified it, and swapping it
#     for that artifact's target is a straight replacement. A file the report names
#     for several artifacts (an uber or shaded jar) and a jar inside another archive
#     cannot be swapped: they are printed as warnings and left out of the file.
#   - two groupIds belong to one project when they are equal or share at least
#     three leading segments; sharing only an organisation prefix does not count.
#   - a release is found by linking jars that (a) have the same version and related
#     groupIds, (b) are copies of the same groupId:artifactId on the same major - a
#     jar patched in one place is patched everywhere in the filesystem - or (c) are
#     in a family: a release spanning two or more related groupIds marks those
#     groupIds as one family, and every jar in one of them on the same major moves
#     in lockstep. Links are followed transitively; artifact names and directories
#     play no part.
#   - target, per release: when every CVE of an installed major.minor line has a fix
#     there, the LATEST fix offered there (patch move); else the lowest same-major
#     minor fixing every CVE (minor move); else the lowest higher major (major
#     move). The release moves to the highest of its lines' targets. Only patch
#     moves are enabled by default.
#   - releases of related groupIds that land on the same target are one group; a
#     member with no CVE whose jump is larger than the vulnerable members' goes to a
#     disabled group of its own, <group>-<major.minor>, with the parent's severity.
#   - group names: the last segment of the members' shared groupId prefix, or the
#     artifactId when the group holds one artifact; a clash appends the target.

import argparse
import hashlib
import os
import re
import sys
from collections import defaultdict

sys.dont_write_bytecode = True     # no __pycache__ next to the scripts
from patchgen import (DEFAULT_LEVELS, SEV_RANK, base_notes, coordinate, gav, plan, read_report,  # noqa: E402
                      add_vuln, tidy, yaml_dump)

TOP_COMMENT = """\
Patch list for plain jars (everything outside karaf). Generated by get-jar-patches;
commit it, review it, edit it by hand.

groups    one entry per unit of work. `apply` is the only switch, all-or-nothing:
          true applies every patch of the group, false applies none. `summary`
          lists every file the group replaces and must match its patches.
patches   one entry per artifact version; every path listed is replaced in place.
          Moving a jar to another group is a matter of changing its `patch-group`
          (and the two summaries): a group moves to one target, so its patches
          must all share it."""

ARCHIVE_RE = re.compile(r'\.(jar|war|ear|rar|zip)$', re.I)


def out_of_scope(path):
    """TEMPORARY: karaf is handled by get-karaf-patches; any path through a
    directory named karaf is skipped until a general karaf test replaces this."""
    return '/karaf/' in '/' + os.path.normpath(path) + '/'


def nested(path):
    """Inside another archive (x.war/WEB-INF/lib/y.jar, outer.jar!/...): not a file on
    disk, so it cannot be swapped."""
    p = os.path.normpath(path)
    return '!' in p or any(ARCHIVE_RE.search(seg) for seg in p.split('/')[:-1])


def main():
    ap = argparse.ArgumentParser(description='Turn a Trivy JSON scan into a committed YAML patch list for plain jars.')
    ap.add_argument('input', help='path to the Trivy JSON report (no default - must be given)')
    ap.add_argument('root', help='path of the container filesystem the report describes; not recorded in the output file')
    ap.add_argument('--out', default='patches.yaml', help='output patch file')
    ap.add_argument('--levels', default=DEFAULT_LEVELS,
                    help='severity levels the patching step should apply (recorded in settings.levels; '
                         'HIGH/CRIT or CRITICAL, MED or MEDIUM, LOW, UNK or UNKNOWN, ALL)')
    args = ap.parse_args()

    report, entries = read_report(args.input)
    root = os.path.normpath(args.root)

    # A file is a candidate when the report names exactly one artifact for it: the
    # scanner identified it (whatever the file is called), and replacing it with that
    # artifact's target is a straight swap. A file the report names for several
    # artifacts is an uber or shaded jar, and a jar inside another archive is not a
    # file on disk: neither can be swapped, so they are only warned about.
    in_scope = [(k, os.path.normpath(path), v, q) for k, path, v, q in entries if not out_of_scope(path)]
    skipped = len(entries) - len(in_scope)
    named = defaultdict(set)       # path -> artifacts the report names there
    for k, path, _, _ in in_scope:
        named[path].add(k)
    paths_of = defaultdict(set)    # (g, a, v) -> standalone files that are that artifact
    kind = defaultdict(set)        # (g, a, v) -> (classifier, type) from the PURL qualifiers
    vulns, unpatchable = {}, set()
    for k, path, v, q in in_scope:
        if len(named[path]) != 1 or nested(path):
            continue
        paths_of[k].add(path)
        kind[k].add((q.get('classifier') or None, q.get('type') or None))
        if v is not None:
            add_vuln(vulns, k, v)
    vuln_keys = {k for k, _, v, _ in in_scope if v is not None}
    not_swappable = sorted((p for p in named if len(named[p]) != 1 or nested(p)),
                           key=lambda p: (not (named[p] & vuln_keys), p))

    missing = sorted(p for ps in paths_of.values() for p in ps if not os.path.lexists(os.path.join(root, p)))

    plan_groups, already = plan(paths_of, vulns, unpatchable)

    group_rows = []                # (sort key, name, group, patches)
    for pg in plan_groups:
        name, target, keys, sev = pg['name'], pg['target'], pg['members'], pg['severity']
        patches, summary = [], defaultdict(list)
        for k in keys:
            g, a, v = k
            paths = sorted(paths_of[k])
            classifier, typ = sorted(kind[k], key=str)[0]     # the report gives one per artifact version
            patches.append(tidy({'patch-group': name, 'method': 'direct', 'groupId': g, 'artifactId': a,
                                 'classifier': classifier, 'type': typ, 'current': v, 'target': target,
                                 'paths': paths}))
            summary[coordinate(g, a, target, classifier, typ)] += paths
        notes = base_notes(pg)
        group = tidy({'apply': not notes, 'severity': sev, 'note': '; '.join(notes) or None,
                      'summary': {c: sorted(ps) for c, ps in sorted(summary.items())}})
        group_rows.append(((-SEV_RANK.get(sev, 0), name), name, group, patches, pg['gjump']))

    group_rows.sort(key=lambda r: r[0])
    groups = {r[1]: r[2] for r in group_rows}
    patches = [p for r in group_rows for p in r[3]]

    header = {'source_sha256': hashlib.sha256(open(args.input, 'rb').read()).hexdigest(),
              'scan_artifact': report.get('ArtifactName')}
    settings = {'levels': args.levels}
    open(args.out, 'w').write(yaml_dump({'settings': settings, 'header': header, 'groups': groups,
                                         'patches': patches}, TOP_COMMENT))

    on = [r for r in group_rows if r[2]['apply']]
    print('groups      : %d (%d apply, %d disabled), %d patches, %d files'
          % (len(group_rows), len(on), len(group_rows) - len(on), len(patches),
             sum(len(p['paths']) for p in patches)))
    print('levels      : %s' % args.levels)
    print('root        : %s (analysis only - not recorded)' % root)
    print('karaf       : %d report entries under a /karaf/ path skipped (temporary rule)' % skipped)
    for k, t in already:
        print('  SKIP %s already at or above the fix %s' % (gav(k), t))
    for r in group_rows:
        if not r[2]['apply']:
            print('REVIEW %s -> %s [%s] %s: %s' % (r[1], r[3][0]['target'], r[4], r[2].get('severity') or '-',
                                                 r[2].get('note', '')))
    for x in sorted(unpatchable):
        print('UNPATCHABLE %s' % x)
    for p in missing:
        print('WARN: not in the analysed tree: %s' % p, file=sys.stderr)
    for p in not_swappable:
        cves = sorted(gav(k) for k in named[p] & vuln_keys)
        print('WARN: %s %s - not patched%s' % (
            'inside another archive:' if nested(p) else 'uber/shaded jar (%d artifacts):' % len(named[p]), p,
            ('; vulnerable inside: %s' % ', '.join(cves)) if cves else ''), file=sys.stderr)


if __name__ == '__main__':
    main()

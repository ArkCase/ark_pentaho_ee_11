#!/usr/bin/env python3
#
# Build-time applier. Reads one committed patch file written by
# generate-patch-lists and applies it during the container build, so the
# patched bundles are baked into the image.
#
# SCOPE: only bundles in karaf's system repo.
#
#   ./apply-patch-lists <patches.yaml> [--levels HIGH,CRIT] [--ignore MED,LOW]
#                       [--snapshot DIR] [--dry-run] [--check]
#                       [--no-osgi-check] [--no-osgi-fail]
#
#   <patches.yaml>  the patch file. Always a parameter - nothing is auto-found.
#                   It is committed to the repo, hand-edited as needed, and read
#                   at build time.
#   root            NOT a parameter and NOT recorded anywhere: each patch names its
#                   karaf home relative to the filesystem root, bundle locations
#                   follow from their coordinates under that home's system repo, and
#                   at build time the root is / - the only root that exists inside
#                   the image. A local run against an extracted tree is the single
#                   exception and must be stated explicitly with --snapshot.
#
# Flags:
#   --levels LIST   comma-separated severities to patch (default HIGH,CRIT, or
#                   settings.levels when the file records one). Accepts CRIT/
#                   CRITICAL, HIGH, MED/MEDIUM, LOW, UNK/UNKNOWN, ALL.
#   --ignore LIST   comma-separated severities to skip; applied after --levels, so
#                   `--levels ALL --ignore LOW,UNK` means everything except those.
#                   A group is filtered on its own severity, so it is taken as a
#                   whole or skipped as a whole.
#   --snapshot DIR  resolve against an extracted tree instead of /. Only for local
#                   verification: inside the image / is the only root that exists,
#                   so a build run has no root to choose. The header prints which
#                   root was used.
#   --no-osgi-check skip the import-package check; it runs by default (see below).
#   --no-osgi-fail  run the check but only warn on violations instead of aborting the
#                   build. Default is to FAIL: a bump that breaks a consumer's import
#                   range produces an image that boots and fails at runtime, so it is
#                   caught at build time. This is a command-line escape only - nothing
#                   in the patch file can turn it off, so a committed list always
#                   carries the fail-by-default guarantee.
#
# Modes:
#   (default)   fetch, osgi check, write
#   --dry-run   print the plan only: no network, no writes
#   --check     fetch + osgi check, write nothing
#
# What is applied: every group whose `apply` is true (and whose severity is in
# scope) has ALL its patches applied; a group set to false has none applied.
# The whole file is validated before anything runs, and any of these aborts:
#   - a patch whose patch-group is not defined under groups
#   - two patches for the same bundle
#   - a group whose patches move to different targets (a group moves to one version)
#   - a group summary that does not match the group's patches (artifact at the
#     target version, source = path of the jar being replaced, relative to the
#     filesystem root)
#   - in a group set to apply: a method other than karaf, a missing coordinate or
#     target, a target not above current, or bundleReplacement URIs that do not
#     move to the target
# A group with no patches only warns.
#
# What method `karaf` does: fetch the target bundle with mvn-get, re-wrap it with
# the vendor headers when the upstream jar is not an OSGi bundle, place it in the
# karaf system repo at its Maven location, drop the superseded version, and
# extend/add the <bundle> replacement in etc/org.apache.karaf.features.xml.
# featureProcessing is always switched on in etc/org.apache.karaf.features.cfg when
# anything is applied: without it karaf ignores the bundleReplacements.
#   osgi check  every consumer Import-Package range is checked against the manifest
#               as actually placed, over the FINAL tree (every patch of a group is
#               placed before any consumer is checked, so a group is never checked
#               half-moved). Fails the build unless --no-osgi-fail is given.
#
# No external Python packages: the YAML reader covers the block-style subset the
# generator writes, plus the usual hand edits (comments, quoting, flow lists).

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import zipfile
import xml.etree.ElementTree as ET

NS = 'http://karaf.apache.org/xmlns/features-processing/v1.0.0'

SEV_RANK = {'CRITICAL': 5, 'HIGH': 4, 'MEDIUM': 3, 'LOW': 2, 'UNKNOWN': 1}
SEV_ALIAS = {'CRIT': 'CRITICAL', 'CRITICAL': 'CRITICAL', 'HIGH': 'HIGH',
             'MED': 'MEDIUM', 'MEDIUM': 'MEDIUM', 'LOW': 'LOW',
             'UNK': 'UNKNOWN', 'UNKNOWN': 'UNKNOWN'}
DEFAULT_LEVELS = 'HIGH,CRIT'
METHODS = ('karaf',)


def sev_name(s):
    return SEV_ALIAS.get((s or '').strip().upper(), 'UNKNOWN')


def sev_level_set(csv):
    out = set()
    for part in (csv or '').split(','):
        part = part.strip().upper()
        if not part:
            continue
        if part == 'ALL':
            out.add('ALL')
        else:
            out.add(SEV_ALIAS.get(part, part))
    return out


def greenf(s): print(s)
def warn(s):  print('WARN: %s' % s, file=sys.stderr)
def note(s):  print('NOTE: %s' % s)
def fatal(s):
    print('FATAL: %s' % s, file=sys.stderr)
    sys.exit(1)


# ---------------------------------------------------------------- YAML (subset)
# Block mappings and sequences nested to any depth, plain / "double" / 'single'
# quoted scalars, empty [] {}, flow lists, full-line and trailing comments. Plain
# scalars are strings except true/false/null and whole integers, as in standard
# YAML; plain decimals stay strings (an unquoted 1.10 is "1.10", not the float 1.1).
# Anything else is rejected with its line number rather than guessed at.
KEY_RE = re.compile(r'^([A-Za-z_][\w.\-]*)\s*:(?:\s+(.*))?$')


def strip_comment(line):
    q, i = None, 0
    while i < len(line):
        ch = line[i]
        if q == '"' and ch == '\\':
            i += 2
            continue
        if q == "'" and ch == "'" and line[i + 1:i + 2] == "'":
            i += 2
            continue
        if q:
            if ch == q:
                q = None
        elif ch in '"\'' and (i == 0 or line[i - 1] in ' -:[{,'):
            q = ch
        elif ch == '#' and (i == 0 or line[i - 1] in ' \t'):
            return line[:i].rstrip()
        i += 1
    return line.rstrip()


def yaml_parse(text, name):
    lines = []
    for n, raw in enumerate(text.splitlines(), 1):
        lead = raw[:len(raw) - len(raw.lstrip())]
        if '\t' in lead:
            fatal('%s line %d: tab in indentation' % (name, n))
        s = strip_comment(raw)
        if not s.strip() or s.strip() in ('---', '...'):
            continue
        lines.append([len(s) - len(s.lstrip(' ')), s.strip(), n])
    if not lines:
        return {}
    ctx = {'name': name}
    val, i = _block(lines, 0, lines[0][0], ctx)
    if i < len(lines):
        fatal('%s line %d: unexpected indentation' % (name, lines[i][2]))
    if not isinstance(val, dict):
        fatal('%s: the top level must be a mapping' % name)
    return val


def _is_item(s):
    return s == '-' or s.startswith('- ')


def _block(lines, i, ind, ctx):
    return (_seq if _is_item(lines[i][1]) else _map)(lines, i, ind, ctx)


def _map(lines, i, ind, ctx):
    out = {}
    while i < len(lines) and lines[i][0] == ind and not _is_item(lines[i][1]):
        m = KEY_RE.match(lines[i][1])
        n = lines[i][2]
        if not m:
            fatal('%s line %d: expected "key: value", got %r' % (ctx['name'], n, lines[i][1]))
        key, rest = m.group(1), (m.group(2) or '').strip()
        if key in out:
            fatal('%s line %d: duplicate key %r' % (ctx['name'], n, key))
        i += 1
        if rest:
            out[key] = _value(rest, n, ctx)
        elif i < len(lines) and (lines[i][0] > ind or (lines[i][0] == ind and _is_item(lines[i][1]))):
            out[key], i = _block(lines, i, lines[i][0], ctx)   # a sequence may sit at the key's indent
        else:
            out[key] = None
    return out, i


def _seq(lines, i, ind, ctx):
    out = []
    while i < len(lines) and lines[i][0] == ind and _is_item(lines[i][1]):
        s, n = lines[i][1], lines[i][2]
        content = s[1:].lstrip()
        if not content:
            i += 1
            if i < len(lines) and lines[i][0] > ind:
                v, i = _block(lines, i, lines[i][0], ctx)
            else:
                v = None
            out.append(v)
        elif KEY_RE.match(content):
            # "- key: value" opens a mapping whose keys line up with "key"
            lines[i] = [ind + len(s) - len(content), content, n]
            v, i = _map(lines, i, lines[i][0], ctx)
            out.append(v)
        else:
            out.append(_value(content, n, ctx))
            i += 1
    return out, i


def _value(v, n, ctx):
    if v == '[]':
        return []
    if v == '{}':
        return {}
    if v[0] in '[{':
        try:
            return json.loads(v)
        except ValueError:
            if v[0] == '[' and v.endswith(']'):          # hand-typed flow list: [a, b]
                return [_value(x.strip(), n, ctx) for x in v[1:-1].split(',') if x.strip()]
            fatal('%s line %d: cannot read %s (quote it if it is a string)' % (ctx['name'], n, v))
    if v[0] == '"':
        try:
            return json.loads(v)
        except ValueError:
            fatal('%s line %d: bad double-quoted string %s' % (ctx['name'], n, v))
    if v[0] == "'":
        if len(v) < 2 or not v.endswith("'"):
            fatal('%s line %d: bad single-quoted string %s' % (ctx['name'], n, v))
        return v[1:-1].replace("''", "'")
    if v in ('true', 'True', 'TRUE'):
        return True
    if v in ('false', 'False', 'FALSE'):
        return False
    if v in ('null', 'Null', 'NULL', '~'):
        return None
    if re.match(r'^[-+]?[0-9]+$', v):
        return int(v)
    return v


# ---------------------------------------------------------------- OSGi helpers
def manifest(path):
    try:
        raw = zipfile.ZipFile(path).read('META-INF/MANIFEST.MF').decode('utf-8', 'replace')
    except Exception:
        return None
    lines = []
    for line in raw.replace('\r\n', '\n').replace('\r', '\n').split('\n'):
        if line.startswith(' '):
            if lines:
                lines[-1] += line[1:]
        elif line:
            lines.append(line)
    return dict((l.split(':', 1)[0], l.split(':', 1)[1].strip()) for l in lines if ':' in l)


def clauses(s):
    out, cur, inb = [], '', False
    for ch in s:
        if ch == '[':
            inb = True
        elif ch == ']':
            inb = False
        if ch == ',' and not inb:
            if cur.strip():
                out.append(cur.strip())
            cur = ''
        else:
            cur += ch
    if cur.strip():
        out.append(cur.strip())
    return out


def vt(s):
    return tuple(int(x) for x in re.findall(r'\d+', s)) or (0,)


def sat(rng, ver):
    if not rng:
        return True
    m = re.match(r'^\[(.+?),(.+?)([)\]])$', rng)
    if not m:
        return vt(ver) >= vt(rng)
    lo, hi, closed = vt(m.group(1)), vt(m.group(2)), m.group(3) == ']'
    v = vt(ver)
    return not (v < lo or v > hi or (v == hi and not closed))


def export_versions(man):
    ver = man.get('Bundle-Version', '0')
    out = {}
    for c in clauses(man.get('Export-Package') or ''):
        pkg = c.split(';')[0]
        x = re.search(r'version="([^"]+)"', c)
        out[pkg] = x.group(1) if x else ver
    return out


# ---------------------------------------------------------------- fetching
def fetch(spec, out):
    """Download with mvn-get (from the base image): it resolves the repository
    (MVN_CENTRAL_REPO), credentials and retries, and verifies the download."""
    r = subprocess.run(['mvn-get', spec, out])
    if r.returncode:
        fatal('mvn-get could not download %s (rc=%d)' % (spec, r.returncode))


def rewrap(dl, template, out, version):
    headers = manifest(template)
    if not headers:
        fatal('no template manifest to wrap %s' % dl)
    with zipfile.ZipFile(dl) as zin, zipfile.ZipFile(out, 'w', zipfile.ZIP_DEFLATED) as zout:
        for item in zin.infolist():
            if item.filename == 'META-INF/MANIFEST.MF':
                continue
            zout.writestr(item, zin.read(item.filename))
        mf = '\r\n'.join('%s: %s' % (k, v) for k, v in headers.items() if k != 'Bundle-Version')
        mf = 'Manifest-Version: 1.0\r\n' + mf + '\r\nBundle-Version: %s\r\n\r\n' % version
        zout.writestr('META-INF/MANIFEST.MF', mf)


def features_xml(path, uri, repl, mode, bsn):
    ET.register_namespace('', NS)
    tree = ET.parse(path)
    root = tree.getroot()
    brs = root.find('{%s}bundleReplacements' % NS)
    if brs is None:
        brs = ET.SubElement(root, '{%s}bundleReplacements' % NS)
    coords = lambda u: tuple(u[len('mvn:'):].split('?')[0].split('/')[:2])
    for e in brs.findall('{%s}bundle' % NS):
        c = coords(e.get('originalUri', ''))
        if c == coords(uri):
            e.set('originalUri', uri)
            e.set('replacement', repl)
            e.set('mode', mode)
            if bsn:
                e.set('symbolicName', bsn)
            print('  extended existing bundleReplacement for %s/%s' % c)
            break
    else:
        attrs = {'mode': mode, 'originalUri': uri, 'replacement': repl}
        if bsn:
            attrs['symbolicName'] = bsn
        ET.SubElement(brs, '{%s}bundle' % NS, attrs)
        print('  added bundleReplacement for %s/%s' % coords(uri))
    tree.write(path, xml_declaration=True, encoding='utf-8')


def ensure_feature_processing(cfg_path):
    text = open(cfg_path).read()
    if re.search(r'^\s*featureProcessing=', text, re.M):
        return
    new = re.sub(r'^#\s*featureProcessing=', 'featureProcessing=', text, flags=re.M)
    if new == text:
        new = 'featureProcessing=org.apache.karaf.features.xml\n' + text
    with open(cfg_path, 'w') as fh:
        fh.write(new)
    print('enabled featureProcessing in %s' % os.path.basename(cfg_path))


def osgi_check(jar, karaf_system, pre_ver, overlay=None):
    """Check every consumer under karaf_system against jar's exports. overlay maps a
    jar in the tree to the fetched jar that replaces it, so --check (which writes
    nothing) still judges the final tree, with every family member moved."""
    overlay = overlay or {}
    man = manifest(jar)
    if not man:
        print('  osgi check: no manifest on %s (plain jar) - nothing to check' % os.path.basename(jar))
        return True
    ex = export_versions(man)
    bad, pre, opt, checked = [], [], [], 0
    for dp, _, fs in os.walk(karaf_system):
        for f in fs:
            if not f.endswith('.jar'):
                continue
            p = overlay.get(os.path.normpath(os.path.join(dp, f)), os.path.join(dp, f))
            if os.path.normpath(p) == os.path.normpath(jar):
                continue
            m = manifest(p)
            if not m:
                continue
            for c in clauses(m.get('Import-Package', '')):
                pkg = c.split(';')[0]
                if pkg not in ex:
                    continue
                checked += 1
                x = re.search(r'version="([^"]+)"', c)
                rng = x.group(1) if x else None
                if sat(rng, ex[pkg]):
                    continue
                row = (m.get('Bundle-SymbolicName', '?'), pkg, rng, ex[pkg])
                if ';resolution:=optional' in c:
                    opt.append(row)
                elif sat(rng, pre_ver):
                    bad.append(row)
                else:
                    pre.append(row)
    for b in bad:
        print('  consumer %s imports %s %s but jar now exports %s' % b, file=sys.stderr)
    for r in pre:
        print('  pre-existing (not introduced by this bump): %s imports %s %s, jar exports %s' % r)
    print('  osgi check: %d consumer imports checked against %s, %d introduced violations, %d optional, %d pre-existing'
          % (checked, man.get('Bundle-SymbolicName', '?'), len(bad), len(opt), len(pre)))
    return not bad


def place(src, dst, mode):
    """Copy the fetched jar into position. A no-op when it is already there
    (path already at the target version), so re-running is idempotent."""
    if os.path.abspath(src) == os.path.abspath(dst):
        return
    shutil.copyfile(src, dst)
    os.chmod(dst, mode)


# ---------------------------------------------------------------- validation
def repo_rel(home, g, a, v):
    """Where a bundle lives in the system repo of the karaf at `home` (Maven layout),
    relative to the filesystem root."""
    return os.path.normpath(os.path.join(home, 'system', g.replace('.', '/'), a, v, '%s-%s.jar' % (a, v)))


def patch_label(p, i):
    return 'patch #%d (%s:%s)' % (i, p.get('groupId'), p.get('artifactId'))


def patch_problems(p, label):
    """Why a patch of a group set to apply cannot be applied. Every switched-on group
    is checked before anything is fetched or written."""
    out = []
    method, target, current = p.get('method'), p.get('target'), p.get('current')
    if method not in METHODS:
        return ['%s: method %r is not supported (supported: %s)' % (label, method, ', '.join(METHODS))]
    if not p.get('karaf') or not p.get('groupId') or not p.get('artifactId') or not current:
        out.append('%s: karaf, groupId, artifactId and current are required' % label)
    if not target:
        out.append('%s: no target version - there is nothing to apply' % label)
    elif current and vt(target) <= vt(current):
        out.append('%s: target %s is not above current %s' % (label, target, current))
    pr = p.get('processing') or {}
    repl, orig = pr.get('replacement') or '', pr.get('originalUri') or ''
    if not repl or not orig:
        out.append('%s: method karaf needs processing.originalUri and processing.replacement' % label)
    elif target and not (re.search(r'/%s(/|$)' % re.escape(target), repl) and (',%s)' % target) in orig):
        out.append('%s: processing URIs (%s -> %s) do not move to target %s; fix them or the target'
                   % (label, orig, repl, target))
    return out


def versions_as_text(e):
    """A hand-typed unquoted version (target: 5) reads as a number; versions are text."""
    for k in ('current', 'target'):
        if e.get(k) is not None and not isinstance(e[k], str):
            e[k] = str(e[k])
    return e


def load_groups(data, problems):
    """groups name the units of work and carry the only switch; patches point at
    their group by name. Referential integrity, one target per group and the
    summaries are checked for every group; the operational checks only for groups
    set to apply."""
    raw = data.get('groups')
    if raw is None:
        raw = {}
    if not isinstance(raw, dict):
        problems.append('groups must be a mapping of group name -> apply/severity/summary')
        return {}
    groups = {}
    for name, g in raw.items():
        if not isinstance(g, dict):
            problems.append('group %s: must be a mapping with apply, severity and summary' % name)
            continue
        if not isinstance(g.get('apply'), bool):
            problems.append('group %s: apply must be true or false, not %r' % (name, g.get('apply')))
        groups[name] = {'name': name, 'apply': g.get('apply') is True, 'severity': sev_name(g.get('severity')),
                        'note': g.get('note'), 'summary': g.get('summary') or [], 'patches': []}

    seen = {}
    for i, p in enumerate(data.get('patches') or [], 1):
        if not isinstance(p, dict):
            problems.append('patch #%d: must be a mapping' % i)
            continue
        versions_as_text(p)
        label = patch_label(p, i)
        pg = p.get('patch-group')
        if pg not in groups:
            problems.append('%s: patch-group %r is not defined under groups' % (label, pg))
            continue
        key = (p.get('karaf'), p.get('groupId'), p.get('artifactId'), p.get('current'))
        if key in seen:
            problems.append('%s: same bundle as patch #%d - a bundle is patched once' % (label, seen[key]))
            continue
        seen[key] = i
        groups[pg]['patches'].append((i, p))

    for g in groups.values():
        name, ps = g['name'], [p for _, p in g['patches']]
        if not ps:
            warn('group %s has no patches - nothing to apply' % name)
        targets = sorted({str(p.get('target')) for p in ps})
        if len(targets) > 1:
            problems.append('group %s: patches move to different targets (%s); a group moves to one version'
                            % (name, ', '.join(targets)))
        want = sorted(('%s:%s:%s' % (p.get('groupId'), p.get('artifactId'), p.get('target')),
                       repo_rel(str(p.get('karaf') or ''), p.get('groupId') or '', p.get('artifactId') or '',
                                p.get('current') or ''))
                      for p in ps)
        have = sorted((str(x.get('artifact')), str(x.get('source'))) for x in g['summary'] if isinstance(x, dict))
        if want != have or len(have) != len(g['summary']):
            problems.append('group %s: summary does not match its patches; it should read:\n%s'
                            % (name, '\n'.join('      - artifact: %s\n        source: %s' % w for w in want)))
        if g['apply']:
            for i, p in g['patches']:
                problems.extend(patch_problems(p, '%s in group %s' % (patch_label(p, i), name)))
        g['target'] = targets[0] if len(targets) == 1 else None
        g['patches'] = ps
    return groups


# ---------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(description='Apply a committed YAML karaf patch list during the container build.')
    ap.add_argument('patches', help='path to the patch file (no default - must be given)')
    ap.add_argument('--levels', default=None,
                    help='severities to patch: comma-separated HIGH,CRIT (default; or settings.levels). '
                         'CRIT/CRITICAL, MED/MEDIUM, LOW, UNK/UNKNOWN, ALL')
    ap.add_argument('--snapshot', default=None,
                    help='resolve against an extracted tree instead of /; '
                         'for local verification runs only - inside the image / is the only root')
    ap.add_argument('--ignore', default=None,
                    help='severities to skip, applied after --levels')
    ap.add_argument('--dry-run', action='store_true', help='print the plan; no network, no writes')
    ap.add_argument('--check', action='store_true', help='fetch + verify + osgi check, write nothing')
    ap.add_argument('--no-osgi-check', dest='no_osgi_check', action='store_true',
                    help='skip the import-package check; it runs by default')
    ap.add_argument('--no-osgi-fail', dest='no_osgi_fail', action='store_true',
                    help='check but only warn on violations instead of aborting the build; '
                         'default is to fail, and this cannot be set from the patch file')
    args = ap.parse_args()

    if not os.path.exists(args.patches):
        fatal('patch file not found: %s' % args.patches)
    data = yaml_parse(open(args.patches).read(), args.patches)
    old = [k for k in ('families', 'karaf', 'jars', 'manual') if k in data]
    if old:
        fatal('%s uses an old layout (%s); regenerate it with generate-patch-lists'
              % (args.patches, ', '.join(old)))
    settings = data.get('settings') or {}         # keys this script does not read are ignored

    problems = []
    groups = load_groups(data, problems)
    if problems:
        fatal('%s cannot be applied as written:\n  %s' % (args.patches, '\n  '.join(problems)))

    # Each patch names its karaf home relative to the filesystem root; bundle locations
    # follow from their coordinates under that home's system repo. The root is not
    # recorded in the patch file: inside the image / is the only root that
    # exists, so it is the default. --snapshot is the single exception, for a local
    # run against an extracted tree, and must be given on the command line.
    root = args.snapshot or '/'
    if not os.path.isabs(root):
        fatal('--snapshot must be an absolute path: %s' % root)
    if args.snapshot:
        warn('resolving against %s instead of / - local run only; the build always uses /' % root)

    def karaf_home(p):
        return os.path.normpath(os.path.join(root, p['karaf']))

    def repo_jar(p, version):
        return os.path.join(root, repo_rel(p['karaf'], p['groupId'], p['artifactId'], version))

    write = not (args.dry_run or args.check)
    fetch_it = not args.dry_run
    run_check = not args.no_osgi_check
    fail_on_check = run_check and not args.no_osgi_fail
    levels = sev_level_set(args.levels or settings.get('levels') or DEFAULT_LEVELS)
    ignore = sev_level_set(args.ignore if args.ignore is not None else settings.get('ignore'))

    def selected(g):
        if g['severity'] in ignore:
            return False
        return 'ALL' in levels or g['severity'] in levels

    units = list(groups.values())
    to_apply = [g for g in units if g['apply'] and selected(g) and g['patches']]
    out_of_scope = [g for g in units if g['apply'] and not selected(g)]
    disabled = [g for g in units if not g['apply']]
    work = [dict(p, unit=g['name']) for g in to_apply for p in g['patches']]
    homes = sorted({p['karaf'] for p in work})
    absent = [h for h in homes if not os.path.isdir(os.path.join(root, h, 'system'))]
    if absent:
        fatal('karaf system repo not found under %s for: %s' % (root, ', '.join(absent)))

    # every bundle to move must be where its coordinates say (or already moved)
    missing = ['%s:%s:%s (group %s) not found at %s' % (p['groupId'], p['artifactId'], p['current'], p['unit'],
                                                        os.path.relpath(repo_jar(p, p['current']), root))
               for p in work if not os.path.exists(repo_jar(p, p['current']))
               and not os.path.exists(repo_jar(p, p['target']))]
    if missing:
        fatal('bundles to patch are not in the karaf system repo:\n  %s' % '\n  '.join(missing))

    print('patch file  : %s' % args.patches)
    print('root        : %s%s' % (root, ' (--snapshot, local run only)' if args.snapshot else ''))
    print('levels      : %s' % (','.join(sorted(levels)) if levels else '(none)'))
    print('ignore      : %s' % (','.join(sorted(ignore)) if ignore else '(none)'))
    print('osgi check  : %s' % ('on, fails the build' if fail_on_check
                                 else 'on, warnings only (--no-osgi-fail)'
                                 if run_check else 'off (--no-osgi-check)'))
    print('groups      : %d (%d set to apply, %d disabled)'
          % (len(units), sum(g['apply'] for g in units), len(disabled)))
    print('applying    : %d groups, %d bundles' % (len(to_apply), len(work)))
    if out_of_scope:
        print('out of severity scope (%d, not applied):' % len(out_of_scope))
        for g in out_of_scope:
            print('  %s %s -> %s' % (g['severity'], g['name'], g['target']))
    if disabled:
        print('disabled (%d, not applied):' % len(disabled))
        for g in disabled:
            print('  %s %s -> %s%s' % (g['severity'], g['name'], g['target'] or '-',
                                       (' - ' + g['note']) if g['note'] else ''))

    if work and fetch_it and not shutil.which('mvn-get'):
        fatal('mvn-get is not on the PATH; it comes with the base image and is required to fetch bundles')

    for h in homes:                # bundleReplacements are ignored unless feature processing is on
        cfg = os.path.join(root, h, 'etc/org.apache.karaf.features.cfg')
        if write:
            ensure_feature_processing(cfg)
        else:
            print('plan: ensure featureProcessing=org.apache.karaf.features.xml in %s' % os.path.relpath(cfg, root))

    # ---- pass 1: fetch and verify everything (so the osgi check sees the final tree) ----
    staged = []
    shown = set()
    for e in work:
        if e['unit'] not in shown:
            shown.add(e['unit'])
            g = groups[e['unit']]
            print('%s -> %s (%s, %d bundle%s)' % (g['name'], g['target'], g['severity'], len(g['patches']),
                                                's' if len(g['patches']) > 1 else ''))
        group, artifact, target, cur = e['groupId'], e['artifactId'], e['target'], e['current']
        spec = '%s:%s:%s:jar' % (group, artifact, target)
        classifier = (e.get('processing') or {}).get('classifier')
        if classifier:
            spec += ':%s' % classifier
        print('  karaf %s/%s %s -> %s' % (group, artifact, cur, target))
        arch_cur, arch_tgt = repo_jar(e, cur), repo_jar(e, target)

        if os.path.exists(arch_tgt):
            note('  already seeded, skipped')
            staged.append((e, arch_tgt))
            continue

        if not fetch_it:
            pr = e.get('processing') or {}
            print('  plan: mvn-get %s (wrap if the upstream jar is not an OSGi bundle)' % spec)
            print('  plan: %s bundleReplacement %s' % (pr.get('action') or 'add', pr.get('originalUri')))
            continue

        out = os.path.join(os.environ.get('TMPDIR') or '/tmp', '%s-%s.jar' % (artifact, target))
        fetch(spec, out)
        if not manifest(out):
            wrapped = out + '.wrapped'
            rewrap(out, arch_cur, wrapped, target)
            out = wrapped
            print('  wrapped: upstream jar is not an OSGi bundle; vendor headers preserved (BSN %s)'
                  % (e.get('symbolic_name') or manifest(arch_cur).get('Bundle-SymbolicName', '?')))
        else:
            print('  native OSGi bundle, manifest as shipped')
        staged.append((e, out))

    # ---- pass 2: write ----
    for e, placed in staged:
        artifact, target, cur = e['artifactId'], e['target'], e['current']
        arch_cur, arch_tgt = repo_jar(e, cur), repo_jar(e, target)
        pr = e.get('processing') or {}
        uri, repl = pr['originalUri'], pr['replacement']
        mode = pr.get('mode') or 'maven'
        bsn = pr.get('symbolicName') or e.get('symbolic_name') or ''
        if not write:
            print('  plan: place %s, remove %s' % (arch_tgt, arch_cur))
            print('  plan: %s bundleReplacement %s' % (pr.get('action') or 'add', uri))
            continue
        os.makedirs(os.path.dirname(arch_tgt), exist_ok=True)
        place(placed, arch_tgt, 0o640)
        cur_dir = os.path.dirname(arch_cur)
        if os.path.isdir(cur_dir) and os.path.abspath(placed) != os.path.abspath(arch_cur):
            shutil.rmtree(cur_dir)
            print('  removed superseded %s' % cur_dir)
        features_xml(os.path.join(karaf_home(e), 'etc/org.apache.karaf.features.xml'), uri, repl, mode, bsn)

    # ---- pass 3: osgi check over the final tree. Every patch of every group is in
    # place (or, in --check, staged) before any consumer is checked, so a group is
    # never judged half-moved ----
    failures = []
    if run_check and fetch_it:
        overlay = {}
        if not write:
            for e, placed in staged:
                overlay[os.path.normpath(repo_jar(e, e['current']))] = placed
        for e, placed in staged:
            if write:
                placed = repo_jar(e, e['target'])
            if not os.path.exists(placed):
                continue
            if not osgi_check(placed, os.path.join(karaf_home(e), 'system'), e['current'], overlay):
                failures.append('%s/%s' % (e['groupId'], e['artifactId']))
        if failures:
            if fail_on_check:
                fatal('osgi check failed for: %s' % ', '.join(failures))
            warn('osgi check failed for: %s (report only)' % ', '.join(failures))
    elif not run_check:
        print('osgi check skipped (--no-osgi-check): karaf moves are unproven')

    if write:
        greenf('patch list applied')
    else:
        note('no writes performed (dry-run/check mode)')


if __name__ == '__main__':
    main()

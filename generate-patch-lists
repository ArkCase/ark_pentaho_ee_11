#!/usr/bin/env python3

# Consumes a Trivy JSON report and writes ONE YAML patch file that
# apply-patch-lists consumes during the container build.
#
# SCOPE: only bundles in karaf's system repo. Everything outside karaf (lib dirs,
# webapps, plugin folders) is ignored entirely and handled by other means.
#
#   ./generate-patch-lists <vulnerabilities.json> <root> [--out patches.yaml]
#                          [--levels HIGH,CRIT] [--no-osgi-check] [--no-osgi-fail]
#
#   <vulnerabilities.json>  the Trivy report. Produced by scan.sh, or assembled
#                           and committed by hand - either is fine. Nothing is
#                           auto-discovered: the file is always a parameter.
#   <root>                  path to the container filesystem that is analysed
#                           (manifests, feature pins). It is NOT recorded: bundle
#                           locations follow from their coordinates.
#   --levels LIST         severity levels recorded for apply-patch-lists (default
#                           HIGH,CRIT). CRIT/CRITICAL, HIGH, MED/MEDIUM, LOW,
#                           UNK/UNKNOWN, ALL.
#   --no-osgi-fail        report OSGi violations as warnings instead of exiting 1.
#                           Default: fail. Nothing is recorded: the applier fails on a
#                           violation unless it is given --no-osgi-fail too.
#   --no-osgi-check       skip the OSGi import-package check. It runs BY DEFAULT: for
#                           every group, walk the consumers in the karaf repo, check
#                           each Import-Package range against the package version that
#                           would be exported AFTER the whole group moves, and disable
#                           a group whose move would break a consumer. Exits 1 when
#                           that is the only thing keeping a group from applying.
#
# Output layout (plain block YAML, hand-editable):
#   settings:  what the applier reads: levels
#   header:    provenance: sha256 of the source report and the scanned image
#   groups:    one entry per unit of work, named for what it moves. `apply` is the
#              only switch and is all-or-nothing; `severity` is the highest severity
#              the group addresses and is what --levels filters on; `summary` lists
#              each bundle it moves (artifact = coordinates at the target version,
#              source = path of the jar it replaces, relative to the filesystem
#              root) for review at a glance; `note` says why a group is disabled by
#              default, and names related vendor wraps that cannot move with it.
#   patches:   what to do, one entry per bundle: `patch-group` names its group,
#              `method` says how it is applied (karaf: seed the bundle into the
#              karaf repo and add a bundleReplacement), coordinates, current and
#              target version, and the bundleReplacement to write.
#
# Nothing is downloaded here: the applier fetches the target jars at build time.
#
# Rules:
#   - coordinates (groupId, artifactId, version) come only from the report:
#     `Vulnerabilities` for what is vulnerable and what fixes each CVE, `Packages`
#     for every bundle in the karaf repo. Jars are opened only for OSGi manifests.
#   - a line is the vulnerable bundles in one groupId hierarchy on one installed
#     major.minor. A library family's root (BouncyCastle, Log4J2, Jetty, Netty,
#     Jackson, Spring, POI) is its hierarchy; any other groupId is its own. Artifact
#     names play no part (bcprov-jdk18on and bcpkix-jdk18on are one line).
#   - target: when every CVE of the line has a fix on the installed major.minor, the
#     LATEST fix offered there for any member of the line (a patch move). Otherwise
#     the lowest same-major minor at which every CVE is fixed, again at the latest
#     fix offered on it (a minor move). When no fix exists on the installed major,
#     the lowest higher major where every CVE is fixed, picked the same way (a major
#     move). Only patch moves are enabled by default.
#   - lines in one hierarchy that land on the same target are one group.
#   - bundles with no CVE of their own join a group when they are below the target
#     and either share the exact version of a member in the same hierarchy
#     (released together) or share a member's groupId:artifactId on that member's
#     major line (a bundle patched in one place is patched everywhere). This
#     repeats until nothing more joins.
#   - a member with no CVE of its own whose version jump is larger than the
#     vulnerable members' (it sits on an older minor or major) goes to a group of
#     its own, named <group>-<major.minor>, disabled by default, with the parent's
#     severity. Vulnerable members are never split off: they move together.
#   - vendor artifacts (org.pentaho, org.hitachivantara), findings with no fix, and
#     findings not at their Maven repo location are printed as unpatchable. A related
#     bundle (same hierarchy and version as a member, or same artifact) that is not
#     at its Maven location - a vendor rebuild or wrap - is named in the group's note:
#     it cannot be swapped and stays on its version.

import argparse
import hashlib
import json
import os
import re
import sys
import zipfile
from collections import defaultdict

VENDOR_GROUPS = ('org.pentaho', 'org.hitachivantara')

# Severity names as Trivy spells them, plus the short forms the user asked for.
SEV_RANK = {'CRITICAL': 5, 'HIGH': 4, 'MEDIUM': 3, 'LOW': 2, 'UNKNOWN': 1}
SEV_ALIAS = {'CRIT': 'CRITICAL', 'CRITICAL': 'CRITICAL', 'HIGH': 'HIGH',
             'MED': 'MEDIUM', 'MEDIUM': 'MEDIUM', 'LOW': 'LOW',
             'UNK': 'UNKNOWN', 'UNKNOWN': 'UNKNOWN'}
DEFAULT_LEVELS = 'HIGH,CRIT'            # what the applier patches unless told otherwise
JUMP_RANK = {'patch': 1, 'minor': 2, 'major': 3}


def sev_name(s):
    return SEV_ALIAS.get((s or '').strip().upper(), 'UNKNOWN')


def max_sev(names):
    names = [n for n in names if n]
    return max(names, key=lambda s: SEV_RANK.get(s, 0)) if names else None

FAMILIES = {
    'bouncycastle': 'org.bouncycastle',
    'log4j2':       'org.apache.logging.log4j',
    'jetty':        'org.eclipse.jetty',
    'netty':        'io.netty',
    'jackson':      'com.fasterxml.jackson',
    'spring':       'org.springframework',
    'poi':          'org.apache.poi',
}
KARAF_SUB = 'app/pentaho/pentaho-server/pentaho-solutions/system/karaf'
KARAF_REPO = '/system/karaf/system/'


def root_of(group):
    """The groupId hierarchy a groupId belongs to: a library family's root groupId
    (com.fasterxml.jackson.core -> com.fasterxml.jackson), otherwise the groupId
    itself. Units never span two roots."""
    for prefix in FAMILIES.values():
        if group == prefix or group.startswith(prefix + '.'):
            return prefix
    return group


def common_group(groups):
    """Longest dotted groupId prefix shared by all the given groupIds."""
    parts = [g.split('.') for g in groups]
    out = []
    for segs in zip(*parts):
        if len(set(segs)) != 1:
            break
        out.append(segs[0])
    return '.'.join(out) or '(mixed)'


def in_karaf_repo(rel):
    return KARAF_REPO in '/' + rel


def vtuple(s):
    return tuple(int(p) for p in re.findall(r'\d+', s)) or (0,)


def vstr(t):
    return '.'.join(str(x) for x in t)


def jump_kind(cur, tgt):
    a, b = vtuple(cur), vtuple(tgt)
    if a[0] != b[0]:
        return 'major'
    if len(a) < 2 or len(b) < 2 or a[1] != b[1]:
        return 'minor'
    return 'patch'


def manifest(jar_path):
    try:
        with zipfile.ZipFile(jar_path) as z:
            raw = z.read('META-INF/MANIFEST.MF').decode('utf-8', 'replace')
    except Exception:
        return None
    lines = []
    for line in raw.replace('\r\n', '\n').replace('\r', '\n').split('\n'):
        if line.startswith(' '):          # continuation line (72-char folding)
            if lines:
                lines[-1] += line[1:]
        elif line:
            lines.append(line)
    return dict((l.split(':', 1)[0], l.split(':', 1)[1].strip()) for l in lines if ':' in l)


def clauses(s):
    # OSGi header clauses are comma-separated, but version ranges [a,b) contain
    # commas themselves; split only outside the brackets.
    out, cur, inb = [], '', False
    for ch in s:
        if ch == '[': inb = True
        elif ch == ']': inb = False
        if ch == ',' and not inb:
            if cur.strip(): out.append(cur.strip())
            cur = ''
        else:
            cur += ch
    if cur.strip(): out.append(cur.strip())
    return out


def parse_range(rng):
    if not rng:
        return None
    m = re.match(r'^\[(.+?),(.+?)([)\]])$', rng)
    if m:
        return (vtuple(m.group(1)), vtuple(m.group(2)), m.group(3) == ']')
    return (vtuple(rng), None, False)


def satisfies(rng, ver):
    p = parse_range(rng)
    if p is None:
        return True
    lo, hi, closed = p
    v = vtuple(ver)
    if lo and v < lo:
        return False
    if hi and (v > hi or (v == hi and not closed)):
        return False
    return True


def export_versions(man):
    ver = man.get('Bundle-Version', '0')
    out = {}
    for clause in clauses(man.get('Export-Package') or ''):
        pkg = clause.split(';')[0].strip()
        m = re.search(r'version="([^"]+)"', clause)
        out[pkg] = m.group(1) if m else ver
    return out


def imports_of(man):
    out = []
    for c in clauses(man.get('Import-Package', '')):
        pkg = c.split(';')[0]
        m = re.search(r'version="([^"]+)"', c)
        out.append((pkg, m.group(1) if m else None))
    return out


# ---------------------------------------------------------------- YAML output
# A plain scalar is written unquoted unless YAML would read it as something else
# (a number, bool, null) or its characters need quoting. Versions are always quoted
# so that 1.10 stays "1.10" for any YAML reader, not the float 1.1.
UNSAFE_PLAIN = re.compile(r'^[\s\-?:,\[\]{}#&*!|>\'"%@`]|: | #|\s$|^$')
NOT_A_STRING = re.compile(r'^(~|null|Null|NULL|true|True|TRUE|false|False|FALSE|y|Y|yes|Yes|YES|'
                          r'n|N|no|No|NO|on|On|ON|off|Off|OFF|'
                          r'[-+]?(\.[0-9]+|[0-9][0-9_]*(\.[0-9_]*)?)([eE][-+]?[0-9]+)?|'
                          r'0x[0-9a-fA-F]+|0o[0-7]+|[-+]?\.(inf|Inf|INF)|\.(nan|NaN|NAN))$')
VERSION_KEYS = ('current', 'target', 'candidates')


def scalar(v, quote=False):
    if v is None:
        return 'null'
    if isinstance(v, bool):
        return 'true' if v else 'false'
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return '[]'                          # only empty containers get here
    if isinstance(v, dict):
        return '{}'
    s = str(v)
    if quote or '\n' in s or UNSAFE_PLAIN.search(s) or NOT_A_STRING.match(s):
        return json.dumps(s)                 # a JSON string is a valid YAML double-quoted scalar
    return s


def dump_node(v, ind, quote=False):
    pad = ' ' * ind
    out = []
    if isinstance(v, dict):
        for k, x in v.items():
            q = k in VERSION_KEYS
            if isinstance(x, (dict, list)) and x:
                out.append('%s%s:' % (pad, k))
                out += dump_node(x, ind + 2, q)
            else:
                out.append('%s%s: %s' % (pad, k, scalar(x, q)))
    else:
        for x in v:
            if isinstance(x, dict) and x:
                sub = dump_node(x, ind + 2, quote)
                sub[0] = pad + '- ' + sub[0].lstrip()
                out += sub
            elif isinstance(x, list) and x:
                out.append(pad + '-')
                out += dump_node(x, ind + 2, quote)
            else:
                out.append('%s- %s' % (pad, scalar(x, quote)))
    return out


TOP_COMMENT = """\
Karaf patch list for apply-patch-lists. Generated by generate-patch-lists; commit
it, review it, edit it by hand. Only bundles in karaf's system repo are covered.

groups    one entry per unit of work. `apply` is the only switch, all-or-nothing:
          true applies every patch of the group, false applies none. `summary`
          must match the group's patches (the applier refuses a stale summary).
patches   one entry per bundle. Moving a bundle to another group is a matter of
          changing its `patch-group` (and the two summaries): a group moves to one
          target, so its patches must all share it."""


def yaml_dump(doc):
    out = ['# ' + l if l else '#' for l in TOP_COMMENT.split('\n')]
    for key, val in doc.items():
        out.append('')
        if isinstance(val, list) and val:
            out.append('%s:' % key)
            for i, item in enumerate(val):
                if i:
                    out.append('')           # one blank line between blocks
                out += dump_node([item], 2)
        elif isinstance(val, dict) and val and key == 'groups':
            out.append('%s:' % key)
            for i, (k, x) in enumerate(val.items()):
                if i:
                    out.append('')
                out += dump_node({k: x}, 2)
        else:
            out += dump_node({key: val}, 0)
    return '\n'.join(out) + '\n'


def main():
    ap = argparse.ArgumentParser(description='Turn a Trivy JSON scan into a committed YAML patch list for karaf.')
    ap.add_argument('input', help='path to the Trivy JSON report (no default - must be given)')
    ap.add_argument('root', help='path of the container filesystem that is analysed; not recorded in the output file')
    ap.add_argument('--out', default='patches.yaml', help='output patch file')
    ap.add_argument('--levels', default=DEFAULT_LEVELS,
                    help='severity levels the applier should patch (recorded in settings.levels; '
                         'HIGH/CRIT or CRITICAL, MED or MEDIUM, LOW, UNK or UNKNOWN, ALL)')
    ap.add_argument('--no-osgi-check', action='store_true', dest='no_osgi_check',
                    help='skip the OSGi import-package check; it runs by default')
    ap.add_argument('--no-osgi-fail', action='store_true', dest='no_osgi_fail',
                    help='warn on OSGi violations instead of exiting 1; nothing is recorded, '
                         'so the applier still fails by default')
    args = ap.parse_args()

    report = json.load(open(args.input))
    results = report.get('Results') or report.get('results') or []
    root = os.path.normpath(args.root)
    karaf_root = os.path.join(root, KARAF_SUB)
    karaf_system = os.path.join(karaf_root, 'system')
    processing_file = os.path.join(karaf_root, 'etc/org.apache.karaf.features.xml')
    processing_text = open(processing_file).read() if os.path.exists(processing_file) else ''
    feature_xmls = [os.path.join(d, f) for d, _, fs in os.walk(karaf_system) for f in fs if f.endswith('.xml')]
    feature_text = '\n'.join(open(x).read() for x in feature_xmls)

    def repo_rel(g, a, v):
        return os.path.join(KARAF_SUB, 'system', g.replace('.', '/'), a, v, '%s-%s.jar' % (a, v))

    def repo_abs(g, a, v):
        return os.path.normpath(os.path.join(root, repo_rel(g, a, v)))

    def gav(k):
        return '%s:%s:%s' % k

    # ---- coordinates come only from the report, never from the jars; karaf repo only ----
    purl_re = re.compile(r'pkg:maven/([^/]+)/([^@]+)@([^?#]+)')
    vulns = {}                     # (g, a, v) -> {'cves': {id: {'fixes', 'severity'}}}
    packages = set()               # (g, a, v) at its Maven location in the karaf repo
    elsewhere = defaultdict(set)   # (g, a, v) -> karaf repo paths that are NOT its Maven location
    unpatchable = set()
    for res in results:
        for v in (res.get('Vulnerabilities') or res.get('vulnerabilities') or []):
            m = purl_re.match((v.get('PkgIdentifier') or {}).get('PURL') or v.get('Purl') or '')
            path = v.get('PkgPath') or v.get('FilePath') or ''
            if not m or not in_karaf_repo(path):
                continue
            key = (m.group(1), m.group(2), v.get('InstalledVersion') or m.group(3))
            if os.path.normpath(path) != os.path.normpath(repo_rel(*key)):
                unpatchable.add('%s at %s - not at its Maven repo location (inside another jar or '
                                'renamed); a bundle swap cannot address it' % (gav(key), path))
                continue
            e = vulns.setdefault(key, {'cves': {}})
            c = e['cves'].setdefault(v.get('VulnerabilityID'), {'fixes': set(), 'severity': 'UNKNOWN'})
            c['fixes'].update(x.strip() for x in (v.get('FixedVersion') or '').split(',') if x.strip())
            c['severity'] = max_sev([c['severity'], sev_name(v.get('Severity'))])
        for pk in (res.get('Packages') or []):
            m = purl_re.match((pk.get('Identifier') or {}).get('PURL') or '')
            if not m or not in_karaf_repo(pk.get('FilePath') or ''):
                continue
            key = (m.group(1), m.group(2), pk.get('Version') or m.group(3))
            if os.path.normpath(pk['FilePath']) == os.path.normpath(repo_rel(*key)):
                packages.add(key)
            else:
                elsewhere[key].add(pk['FilePath'])

    def sev_of(k):
        return max_sev(c['severity'] for c in vulns[k]['cves'].values())

    # ---- consumer picture (OSGi) ----
    consumers = []
    for dirpath, _, files in os.walk(karaf_system):
        for f in files:
            if not f.endswith('.jar'):
                continue
            p = os.path.normpath(os.path.join(dirpath, f))
            man = manifest(p)
            if not man:
                continue
            bsn = man.get('Bundle-SymbolicName', '').split(';')[0]
            for pkg, rng in imports_of(man):
                consumers.append((bsn, pkg, rng, p))

    pin_re = lambda g, a: re.compile(r'mvn:%s/%s/([0-9][^/<]*)(?:/([a-zA-Z][^/>]*))?' % (re.escape(g), re.escape(a)))

    def processing_block(group, artifact, target):
        pins = set(pin_re(group, artifact).findall(feature_text))
        classifier = next((c for _, c in sorted(pins) if c), None)
        ex = re.search(r'originalUri="mvn:%s/%s/\[([^],]+),([^)\]]+)\)"' % (re.escape(group), re.escape(artifact)), processing_text)
        lo = vtuple(ex.group(1)) if ex else min((vtuple(p) for p, _ in pins), default=(0,))
        suffix = ('/' + classifier) if classifier else ''
        return tidy({
            'action': 'extend' if ex else 'add',
            'existing_originalUri': 'mvn:%s/%s/[%s,%s)' % (group, artifact, ex.group(1), ex.group(2)) if ex else None,
            'originalUri': 'mvn:%s/%s/[%s,%s)%s' % (group, artifact, vstr(lo), target, suffix),
            'replacement': 'mvn:%s/%s/%s%s' % (group, artifact, target, suffix),
            'mode': 'maven',
            'classifier': classifier,
        })

    def bundle_info(jar_abs, group, artifact):
        man = manifest(jar_abs) if os.path.exists(jar_abs) else None
        bsn = man.get('Bundle-SymbolicName', '').split(';')[0].strip() if man else ''
        norm = artifact.replace('-', '')
        native = bsn and (norm in bsn.replace('.', '').replace('-', '') or bsn.startswith(group))
        return bsn, bool(bsn) and not native

    def osgi_predict(moving, target):
        """moving: [(jar_abs, wrapped)] that all move to target together. Consumers
        that are themselves moving are skipped: they move with the group and are
        re-checked against their fetched manifests by the applier."""
        if args.no_osgi_check:
            return {'status': 'skipped'}
        skip = {j for j, _ in moving}
        viol, pre, checked = [], [], 0
        for jar, wrapped in moving:
            man = manifest(jar) if os.path.exists(jar) else None
            mine = export_versions(man) if man else {}
            for cb, pkg, rng, cp in consumers:
                if pkg not in mine or cp in skip:     # OSGi ignores self-imports
                    continue
                checked += 1
                before = mine[pkg]
                after = before if wrapped else target  # rewrap preserves Export-Package verbatim
                if satisfies(rng, after):
                    continue
                row = '%s imports %s %s; exported %s before, %s after' % (cb, pkg, rng, before, after)
                (pre if not satisfies(rng, before) else viol).append(row)
        return {'status': 'fail' if viol else 'pass', 'checked': checked, 'violations': viol, 'pre': pre}

    def tidy(e):
        return {k: v for k, v in e.items() if v not in (None, [], '')}

    # ---- lines: vulnerable bundles in one groupId hierarchy on one installed major.minor ----
    lines_ = defaultdict(list)     # (root, (major, minor)) -> [(g, a, v)]
    already = []
    for k, e in sorted(vulns.items()):
        if k[0].startswith(VENDOR_GROUPS):
            unpatchable.add('%s - vendor artifact, not on Maven Central; needs the vendor release' % gav(k))
            continue
        if not any(c['fixes'] for c in e['cves'].values()):
            unpatchable.add('%s - no fixed version reported' % gav(k))
            continue
        lines_[(root_of(k[0]), vtuple(k[2])[:2])].append(k)

    def pick_target(line_mm, cve_fix_sets):
        """The major.minor to land on is the installed one when every CVE has a fix
        there (patch move); otherwise the lowest same-major minor at which every CVE
        is fixed (minor move). Within that major.minor the LATEST fix offered for any
        member is taken. None: some CVE has no fix on this major."""
        need = []
        for fs in cve_fix_sets:
            same = sorted((f for f in fs if vtuple(f)[0] == line_mm[0] and vtuple(f)[:2] >= line_mm), key=vtuple)
            if not same:
                return None
            need.append(same[0])
        mm = max(vtuple(f)[:2] for f in need)
        return max((f for fs in cve_fix_sets for f in fs if vtuple(f)[:2] == mm), key=vtuple)

    def pick_any(line_mm, cve_fix_sets):
        """pick_target on the installed major, else on the lowest higher major where
        every CVE is fixed (a major move)."""
        t = pick_target(line_mm, cve_fix_sets)
        if t:
            return t
        for major in sorted({vtuple(f)[0] for fs in cve_fix_sets for f in fs if vtuple(f)[0] > line_mm[0]}):
            t = pick_target((major, 0), cve_fix_sets)
            if t:
                return t
        return None

    units = defaultdict(list)      # (root, target) -> [(g, a, v)]
    for (root_, mm), arts in sorted(lines_.items()):
        cve_fix_sets = [c['fixes'] for k in arts for c in vulns[k]['cves'].values() if c['fixes']]
        target = pick_any(mm, cve_fix_sets)
        if target is None:
            for k in arts:
                unpatchable.add('%s - no single major line fixes every CVE' % gav(k))
            continue
        for k in arts:
            if vtuple(target) <= vtuple(k[2]):
                already.append((k, target))
            else:
                units[(root_, target)].append(k)

    # ---- companions: bundles with no CVE of their own that move with a group ----
    claimed = {k for arts in units.values() for k in arts}
    built = []                     # [{'root', 'target', 'members': {(g,a,v): joined}}]
    for (root_, target), arts in sorted(units.items()):
        mem = {k: 'vulnerable' for k in arts}
        cand = sorted(k for k in packages if root_of(k[0]) == root_ and k not in vulns)
        while True:
            took = False
            for k in cand:
                if k in mem or k in claimed or vtuple(k[2]) >= vtuple(target):
                    continue
                ordered = sorted(mem, key=lambda m: (m not in vulns, m))   # vulnerable members first
                sib, how = next((m for m in ordered if m[2] == k[2]), None), 'same version as'
                if not sib:
                    sib, how = next((m for m in ordered if m[:2] == k[:2]
                                     and vtuple(m[2])[0] == vtuple(k[2])[0]), None), 'same artifact as'
                if sib:
                    mem[k] = '%s %s' % (how, gav(sib))
                    claimed.add(k)
                    took = True
            if not took:
                break
        built.append({'root': root_, 'target': target, 'members': mem})

    # ---- split off companions whose jump is larger than the vulnerable members' ----
    final = []                     # [{'root', 'target', 'members', 'parent', 'mm'}]
    for u in built:
        vj = max((jump_kind(k[2], u['target']) for k, how in u['members'].items() if how == 'vulnerable'),
                 key=JUMP_RANK.get)
        keep, split = {}, defaultdict(dict)
        for k, how in u['members'].items():
            if how != 'vulnerable' and JUMP_RANK[jump_kind(k[2], u['target'])] > JUMP_RANK[vj]:
                split[vtuple(k[2])[:2]][k] = how
            else:
                keep[k] = how
        main_i = len(final)
        final.append(dict(u, members=keep, parent=None, mm=None))
        for mm, ms in sorted(split.items()):
            final.append(dict(u, members=ms, parent=main_i, mm=mm))

    # ---- group names: short, deterministic, unique ----
    fam_name = {v: k for k, v in FAMILIES.items()}
    per_root = defaultdict(int)
    for u in final:
        if u['mm'] is None:
            per_root[u['root']] += 1
    names = []
    used = set()
    for u in final:
        if u['mm'] is not None:
            base = '%s-%s' % (names[u['parent']], '.'.join(str(x) for x in u['mm']))
        elif u['root'] in fam_name:
            base = fam_name[u['root']]
            if per_root[u['root']] > 1:
                cg = common_group(k[0] for k in u['members'])
                seg = cg[len(u['root']) + 1:].split('.')[0] if cg.startswith(u['root'] + '.') else ''
                base = '%s-%s' % (base, seg) if seg else '%s-%s' % (base, u['target'])
        else:
            arts = sorted({k[1] for k in u['members']})
            base = arts[0] if len(arts) == 1 else u['root'].split('.')[-1]
        name = base if base not in used else '%s-%s' % (base, u['target'])
        used.add(name)
        names.append(name)

    # ---- build groups and patches ----
    group_rows = []                # (sort key, name, group, patches, chk, gjump, split parent)
    for i, u in enumerate(final):
        name, target, mem = names[i], u['target'], u['members']
        keys = sorted(mem)
        jumps = {k: jump_kind(k[2], target) for k in keys}
        gjump = max(jumps.values(), key=JUMP_RANK.get)
        parent = final[u['parent']] if u['mm'] is not None else None
        sev = max_sev(sev_of(k) for k in (parent['members'] if parent else mem) if k in vulns)
        patches, moving = [], []
        for k in keys:
            g, a, v = k
            bsn, wrapped = bundle_info(repo_abs(*k), g, a)
            moving.append((repo_abs(*k), wrapped))
            patches.append(tidy({'patch-group': name, 'method': 'karaf', 'groupId': g, 'artifactId': a,
                                 'current': v, 'target': target, 'symbolic_name': bsn or None,
                                 'processing': processing_block(g, a, target)}))
        chk = osgi_predict(moving, target)
        notes = []
        if parent:
            notes.append('members of %s with no CVE of their own, on an older line' % names[u['parent']])
        if gjump != 'patch':
            olds = sorted({k[2] for k in keys}, key=vtuple)
            notes.append('%s version jump (%s -> %s)' % (gjump, ', '.join(olds), target))
        if chk['status'] == 'fail':
            notes.append('import-range violation introduced by the move')
        # related bundles that cannot move with the group: same hierarchy and version as
        # a member (or same artifact) but not at their Maven location - vendor rebuilds
        # and wraps. They stay on their version; said in the note, not a reason to disable.
        vers, gas = {k[2] for k in keys}, {k[:2] for k in keys}
        stuck = sorted(os.path.basename(x) for k, ps in elsewhere.items()
                       if root_of(k[0]) == u['root'] and (k[2] in vers or k[:2] in gas) for x in ps)
        left = ('vendor wraps cannot be swapped and stay on their version: %s' % ', '.join(stuck)) if stuck else None
        group = tidy({'apply': not notes, 'severity': sev, 'note': '; '.join(notes + [left] * bool(left)) or None,
                      'summary': [{'artifact': '%s:%s:%s' % (k[0], k[1], target),
                                   'source': repo_rel(*k)} for k in keys]})
        group_rows.append(((-SEV_RANK.get(sev, 0), name), name, group, patches, chk, gjump, parent))

    group_rows.sort(key=lambda r: r[0])
    groups = {r[1]: r[2] for r in group_rows}
    patches = [p for r in group_rows for p in r[3]]

    header = {'source_sha256': hashlib.sha256(open(args.input, 'rb').read()).hexdigest(),
              'scan_artifact': report.get('ArtifactName')}
    settings = {'levels': args.levels}           # severity levels the applier patches
    open(args.out, 'w').write(yaml_dump({'settings': settings, 'header': header, 'groups': groups,
                                         'patches': patches}))

    on = [r for r in group_rows if r[2]['apply']]
    print('groups      : %d (%d apply, %d disabled), %d patches'
          % (len(group_rows), len(on), len(group_rows) - len(on), len(patches)))
    print('levels      : %s' % args.levels)
    print('root        : %s (analysis only - not recorded)' % root)
    for k, t in already:
        print('  SKIP %s already at or above the fix %s' % (gav(k), t))
    for r in group_rows:
        if not r[2]['apply']:
            print('REVIEW %s -> %s [%s] %s: %s' % (r[1], r[3][0]['target'], r[5], r[2].get('severity') or '-',
                                                 r[2].get('note', '')))
    for x in sorted(unpatchable):
        print('UNPATCHABLE %s' % x)
    if args.no_osgi_check:
        print('osgi check skipped: karaf moves are recorded unproven')
        return
    # exit 1 only when the OSGi check alone is what keeps a group from applying
    fails = [r for r in group_rows if r[4]['status'] == 'fail' and r[5] == 'patch' and not r[6]]
    for r in group_rows:
        if r[4]['status'] == 'fail':
            print('%s %s -> %s : %s'
                  % ('OSGI CHECK FAIL' if r in fails and not args.no_osgi_fail else 'OSGI CHECK WARN' if r in fails
                     else 'OSGI (group already disabled)', r[1], r[3][0]['target'], '; '.join(r[4]['violations'])))
    if fails and not args.no_osgi_fail:
        sys.exit(1)


if __name__ == '__main__':
    main()

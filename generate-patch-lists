#!/usr/bin/env python3

# Consumes a Trivy JSON report and writes ONE YAML patch file that
# apply-patch-lists consumes during the container build.
#
#   ./generate-patch-lists <vulnerabilities.json> <root> [--out patches.yaml]
#                          [--levels HIGH,CRIT] [--strict] [--no-osgi-check] [--no-osgi-fail]
#
#   <vulnerabilities.json>  the Trivy report. Produced by scan.sh, or assembled
#                           and committed by hand - either is fine. Nothing is
#                           auto-discovered: the file is always a parameter.
#   <root>                  ABSOLUTE path to the container filesystem that is
#                           analysed (jar paths, manifests, feature pins). It is
#                           NOT recorded: entry paths are written relative to the
#                           filesystem root because that is how Trivy reports them,
#                           so at build time app/tomcat/... is /app/tomcat/...
#                           Point it at the extracted snapshot to work locally.
#   --levels LIST         severity levels recorded for apply-patch-lists (default
#                           HIGH,CRIT). CRIT/CRITICAL, HIGH, MED/MEDIUM, LOW,
#                           UNK/UNKNOWN, ALL.
#   --no-osgi-fail        report OSGi violations as warnings instead of exiting 1.
#                           Default: fail. Nothing is recorded: the applier fails on a
#                           violation unless it is given --no-osgi-fail too.
#   --strict              records settings.strict_sha1: true, so the applier aborts on
#                           sha1 mismatch instead of warning. The applier is lenient by
#                           default, which is right for local iteration; a CI build
#                           should generate with --strict.
#   --no-osgi-check       skip the OSGi import-package check. It runs BY DEFAULT:
#                           for every bump in the karaf system repo (a whole family at
#                           once), walk the consumers, check each Import-Package range
#                           against the package version that would be exported AFTER
#                           the move, record the result as osgi_check, and exit
#                           non-zero if the move would break a consumer. A failing
#                           unit is parked as manual instead of being applied, so this
#                           check is the reason something is or is not safe to
#                           automate. Skipping it records units as unproven.
#
# Output layout (plain block YAML, hand-editable):
#   settings:  what the applier reads: levels, feature_processing, strict_sha1
#   header:    provenance: source report and its sha256, the target rule
#   families:  the only list. Every entry is a set of members that move to one
#              target together, switched on or off by the entry's `lane`. A library
#              family (one release line within one classpath scope: the karaf
#              system repo, or one lib directory) has several members; any other
#              fix is simply a family of one.
#
# `lane` is the only switch, and it lives on the family:
#   auto     apply every member
#   manual   apply none; `reason` says why, and the comment on the lane line says
#            whether setting it to auto would work or it cannot be applied at all
# Each member's `mechanism` says how it is applied - not a switch:
#   karaf    seed the bundle into karaf's Maven repo and add a bundleReplacement
#   jar      replace the file in place
#
# Rules:
#   - target = smallest FixedVersion candidate on the same major line as the
#     installed version.
#   - patch-level jumps are automatable; a minor or major jump is flagged for
#     manual review (in a family: any member's jump parks the whole family).
#   - family members move in lockstep: within a family (BouncyCastle, Log4J2, Jetty,
#     Netty, Jackson, Spring, POI) every member on the same release line and in the
#     same scope moves to one version, the highest target any member needs, because
#     consumers pin import ranges against the family version. Scope is the karaf
#     system repo or a single lib directory: members only have to agree with the
#     jars they are loaded alongside. Vendor rebuilds (org.pentaho,
#     org.hitachivantara) have no upstream release to move to and are listed as
#     left_in_place; the OSGi check covers whether they still resolve.
#   - every member carries the severity of its own CVEs; a family carries the
#     highest severity among its members, and is filtered on that as a whole.

import argparse
import hashlib
import json
import os
import re
import sys
import zipfile
from collections import defaultdict

VENDOR_GROUPS = ('org.pentaho', 'org.hitachivantara')

# Severity names as Trivy spells them, plus the short forms the user asked for.
SEV_RANK = {'CRITICAL': 5, 'HIGH': 4, 'MEDIUM': 3, 'LOW': 2, 'UNKNOWN': 1}
SEV_ALIAS = {'CRIT': 'CRITICAL', 'CRITICAL': 'CRITICAL', 'HIGH': 'HIGH',
             'MED': 'MEDIUM', 'MEDIUM': 'MEDIUM', 'LOW': 'LOW',
             'UNK': 'UNKNOWN', 'UNKNOWN': 'UNKNOWN'}
DEFAULT_LEVELS = 'HIGH,CRIT'            # what the applier patches unless told otherwise
JUMP_RANK = {'patch': 1, 'minor': 2, 'major': 3}


def sev_name(s):
    return SEV_ALIAS.get((s or '').strip().upper(), 'UNKNOWN')


def max_sev(names):
    names = [n for n in names if n]
    return max(names, key=lambda s: SEV_RANK.get(s, 0)) if names else None

FAMILIES = {
    'bouncycastle': 'org.bouncycastle',
    'log4j2':       'org.apache.logging.log4j',
    'jetty':        'org.eclipse.jetty',
    'netty':        'io.netty',
    'jackson':      'com.fasterxml.jackson',
    'spring':       'org.springframework',
    'poi':          'org.apache.poi',
}
# artifact-name prefixes so family members are found on disk even when Trivy
# did not flag them (a family member with no CVE still has to move with the group)
FAM_PREFIXES = {
    'bouncycastle': ('bc',),
    'log4j2':       ('log4j',),
    'jetty':        ('jetty',),
    'netty':        ('netty',),
    'jackson':      ('jackson',),
    'spring':       ('spring',),
    'poi':          ('poi',),
}
# groupId by artifact prefix, used only when a jar found on disk names no groupId
# (not in the karaf repo layout, no META-INF/maven/*/pom.properties). First match wins.
GROUP_BY_PREFIX = (
    ('jackson', 'jackson-dataformat-', 'com.fasterxml.jackson.dataformat'),
    ('jackson', 'jackson-datatype-', 'com.fasterxml.jackson.datatype'),
    ('jackson', 'jackson-module-', 'com.fasterxml.jackson.module'),
    ('jackson', 'jackson-jaxrs-', 'com.fasterxml.jackson.jaxrs'),
    ('jackson', 'jackson-jakarta-rs-', 'com.fasterxml.jackson.jakarta.rs'),
    ('jackson', 'jackson-', 'com.fasterxml.jackson.core'),
    ('spring', 'spring-data-', 'org.springframework.data'),
    ('spring', 'spring-ws-', 'org.springframework.ws'),
    ('spring', 'spring-xml', 'org.springframework.ws'),
    ('spring', 'spring-security-', 'org.springframework.security'),
    ('spring', 'spring-', 'org.springframework'),
)

KARAF_SUB = 'app/pentaho/pentaho-server/pentaho-solutions/system/karaf'
KARAF_REPO = '/system/karaf/system/'
JAR_RE = re.compile(r'^(?P<art>.+)-(?P<ver>\d[\d.]*)\.jar$')


def family_of(group):
    for name, prefix in FAMILIES.items():
        if group == prefix or group.startswith(prefix + '.'):
            return name
    return None


def family_of_artifact(name):
    for fam, prefixes in FAM_PREFIXES.items():
        if any(name.startswith(p) for p in prefixes):
            return fam
    return None


def release_line(group, artifact):
    """Release line within a family: jdk18on vs jdk15to18 vs fips for BouncyCastle,
    the Spring project (data, ws, security...) for Spring, else the family itself."""
    m = re.search(r'-(jdk\d+\w*|fips)$', artifact)
    if m:
        return m.group(1)
    if group.startswith('org.springframework.'):
        return group[len('org.springframework.'):].split('.')[0]
    return 'main'


def in_karaf_repo(rel):
    return KARAF_REPO in '/' + rel


def scope_of(rel):
    """Where a jar is loaded from: the karaf system repo, or its lib directory."""
    return 'karaf' if in_karaf_repo(rel) else os.path.dirname(rel)


def guess_group(fam, artifact):
    for f, prefix, group in GROUP_BY_PREFIX:
        if f == fam and artifact.startswith(prefix):
            return group
    return FAMILIES[fam]


def jar_group(abs_path, rel, artifact, fam):
    """Real Maven groupId of a jar found on disk: karaf repo layout first, then the
    jar's own pom.properties. Without either, the jar is only taken as a family
    member if it really carries classes in the family's package namespace (a name
    match alone is not enough: codehaus jackson-core-asl 1.x is not com.fasterxml),
    and the groupId comes from the family naming convention. None = not a member."""
    if in_karaf_repo(rel):
        parts = ('/' + rel).split(KARAF_REPO, 1)[1].split('/')
        if len(parts) >= 4:
            return '.'.join(parts[:-3])
    try:
        with zipfile.ZipFile(abs_path) as z:
            names = z.namelist()
    except Exception:
        return None
    for n in names:
        m = re.match(r'META-INF/maven/([^/]+)/([^/]+)/pom\.properties$', n)
        if m and m.group(2) == artifact:
            return m.group(1)
    ns = FAMILIES[fam].replace('.', '/') + '/'
    if not any(n.startswith(ns) and n.endswith('.class') for n in names):
        return None
    return guess_group(fam, artifact)


def vtuple(s):
    return tuple(int(p) for p in re.findall(r'\d+', s)) or (0,)


def vstr(t):
    return '.'.join(str(x) for x in t)


def jump_kind(cur, tgt):
    a, b = vtuple(cur), vtuple(tgt)
    if a[0] != b[0]:
        return 'major'
    if len(a) < 2 or len(b) < 2 or a[1] != b[1]:
        return 'minor'
    return 'patch'


def manifest(jar_path):
    try:
        with zipfile.ZipFile(jar_path) as z:
            raw = z.read('META-INF/MANIFEST.MF').decode('utf-8', 'replace')
    except Exception:
        return None
    lines = []
    for line in raw.replace('\r\n', '\n').replace('\r', '\n').split('\n'):
        if line.startswith(' '):          # continuation line (72-char folding)
            if lines:
                lines[-1] += line[1:]
        elif line:
            lines.append(line)
    return dict((l.split(':', 1)[0], l.split(':', 1)[1].strip()) for l in lines if ':' in l)


def clauses(s):
    # OSGi header clauses are comma-separated, but version ranges [a,b) contain
    # commas themselves; split only outside the brackets.
    out, cur, inb = [], '', False
    for ch in s:
        if ch == '[': inb = True
        elif ch == ']': inb = False
        if ch == ',' and not inb:
            if cur.strip(): out.append(cur.strip())
            cur = ''
        else:
            cur += ch
    if cur.strip(): out.append(cur.strip())
    return out


def parse_range(rng):
    if not rng:
        return None
    m = re.match(r'^\[(.+?),(.+?)([)\]])$', rng)
    if m:
        return (vtuple(m.group(1)), vtuple(m.group(2)), m.group(3) == ']')
    return (vtuple(rng), None, False)


def satisfies(rng, ver):
    p = parse_range(rng)
    if p is None:
        return True
    lo, hi, closed = p
    v = vtuple(ver)
    if lo and v < lo:
        return False
    if hi and (v > hi or (v == hi and not closed)):
        return False
    return True


def export_versions(man):
    ver = man.get('Bundle-Version', '0')
    out = {}
    for clause in clauses(man.get('Export-Package') or ''):
        pkg = clause.split(';')[0].strip()
        m = re.search(r'version="([^"]+)"', clause)
        out[pkg] = m.group(1) if m else ver
    return out


def imports_of(man):
    out = []
    for c in clauses(man.get('Import-Package', '')):
        pkg = c.split(';')[0]
        m = re.search(r'version="([^"]+)"', c)
        out.append((pkg, m.group(1) if m else None))
    return out


# ---------------------------------------------------------------- YAML output
class Commented:
    """A scalar written with a trailing `# comment` (the lane hints)."""
    def __init__(self, value, comment):
        self.value, self.comment = value, comment


def plain(v):
    return v.value if isinstance(v, Commented) else v


# A plain scalar is written unquoted unless YAML would read it as something else
# (a number, bool, null) or its characters need quoting. Versions are always quoted
# so that 1.10 stays "1.10" for any YAML reader, not the float 1.1.
UNSAFE_PLAIN = re.compile(r'^[\s\-?:,\[\]{}#&*!|>\'"%@`]|: | #|\s$|^$')
NOT_A_STRING = re.compile(r'^(~|null|Null|NULL|true|True|TRUE|false|False|FALSE|y|Y|yes|Yes|YES|'
                          r'n|N|no|No|NO|on|On|ON|off|Off|OFF|'
                          r'[-+]?(\.[0-9]+|[0-9][0-9_]*(\.[0-9_]*)?)([eE][-+]?[0-9]+)?|'
                          r'0x[0-9a-fA-F]+|0o[0-7]+|[-+]?\.(inf|Inf|INF)|\.(nan|NaN|NAN))$')
VERSION_KEYS = ('current', 'target', 'candidates')


def scalar(v, quote=False):
    if isinstance(v, Commented):
        return '%s  # %s' % (scalar(v.value, quote), v.comment)
    if v is None:
        return 'null'
    if isinstance(v, bool):
        return 'true' if v else 'false'
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return '[]'                          # only empty containers get here
    if isinstance(v, dict):
        return '{}'
    s = str(v)
    if quote or '\n' in s or UNSAFE_PLAIN.search(s) or NOT_A_STRING.match(s):
        return json.dumps(s)                 # a JSON string is a valid YAML double-quoted scalar
    return s


def dump_node(v, ind, quote=False):
    pad = ' ' * ind
    out = []
    if isinstance(v, dict):
        for k, x in v.items():
            q = k in VERSION_KEYS
            if isinstance(x, (dict, list)) and x:
                out.append('%s%s:' % (pad, k))
                out += dump_node(x, ind + 2, q)
            else:
                out.append('%s%s: %s' % (pad, k, scalar(x, q)))
    else:
        for x in v:
            if isinstance(x, dict) and x:
                sub = dump_node(x, ind + 2, quote)
                sub[0] = pad + '- ' + sub[0].lstrip()
                out += sub
            elif isinstance(x, list) and x:
                out.append(pad + '-')
                out += dump_node(x, ind + 2, quote)
            else:
                out.append('%s- %s' % (pad, scalar(x, quote)))
    return out


TOP_COMMENT = """\
Patch list for apply-patch-lists. Generated by generate-patch-lists; commit it,
review it, edit it by hand.

Every entry under `families` moves to one target as a unit. A library family has
several members; any other fix is a family of one.

`lane` is the only switch:
  auto    apply every member of the family
  manual  apply none; `reason` says why. The comment on the lane line says whether
          auto would work or the family cannot be applied at all.
Each member's `mechanism` says how it is applied (not a switch):
  karaf   seed the bundle into karaf's Maven repo and add a bundleReplacement
  jar     replace the file in place"""


def yaml_dump(doc):
    out = ['# ' + l if l else '#' for l in TOP_COMMENT.split('\n')]
    for key, val in doc.items():
        out.append('')
        if isinstance(val, list) and val:
            out.append('%s:' % key)
            for i, item in enumerate(val):
                if i:
                    out.append('')           # one blank line between blocks
                out += dump_node([item], 2)
        else:
            out += dump_node({key: val}, 0)
    return '\n'.join(out) + '\n'


def main():
    ap = argparse.ArgumentParser(description='Turn a Trivy JSON scan into a committed YAML patch list.')
    ap.add_argument('input', help='path to the Trivy JSON report (no default - must be given)')
    ap.add_argument('root', help='ABSOLUTE path of the container filesystem that is analysed; not recorded in the output file')
    ap.add_argument('--out', default='patches.yaml', help='output patch file')
    ap.add_argument('--levels', default=DEFAULT_LEVELS,
                    help='severity levels the applier should patch (recorded in settings.levels; '
                         'HIGH/CRIT or CRITICAL, MED or MEDIUM, LOW, UNK or UNKNOWN, ALL)')
    ap.add_argument('--strict', action='store_true',
                    help='record strict sha1 in the file: the applier aborts on mismatch instead of warning')
    ap.add_argument('--no-osgi-check', action='store_true', dest='no_osgi_check',
                    help='skip the OSGi import-package check; it runs by default')
    ap.add_argument('--no-osgi-fail', action='store_true', dest='no_osgi_fail',
                    help='warn on OSGi violations instead of exiting 1; nothing is recorded, '
                         'so the applier still fails by default')
    args = ap.parse_args()

    if not os.path.isabs(args.root):
        ap.error('root must be an absolute path within the container (e.g. /, or the absolute path of the extracted snapshot)')

    report = json.load(open(args.input))
    results = report.get('Results') or report.get('results') or []
    root = os.path.normpath(args.root)
    karaf_root = os.path.join(root, KARAF_SUB)
    karaf_system = os.path.join(karaf_root, 'system')
    processing_file = os.path.join(karaf_root, 'etc/org.apache.karaf.features.xml')
    processing_text = open(processing_file).read() if os.path.exists(processing_file) else ''
    feature_xmls = [os.path.join(d, f) for d, _, fs in os.walk(karaf_system) for f in fs if f.endswith('.xml')]
    feature_text = '\n'.join(open(x).read() for x in feature_xmls)

    # ---- hits ----
    hits = {}
    for res in results:
        for v in (res.get('Vulnerabilities') or res.get('vulnerabilities') or []):
            purl = (v.get('PkgIdentifier') or {}).get('PURL') or v.get('Purl') or ''
            m = re.match(r'pkg:maven/([^/]+)/([^@]+)@([^+]+)', purl)
            if not m:
                continue
            key = (m.group(1), m.group(2), m.group(3), v.get('PkgPath') or v.get('FilePath') or '')
            hits.setdefault(key, {'group': m.group(1), 'artifact': m.group(2),
                                  'current': v.get('InstalledVersion') or m.group(3),
                                  'path': key[3], 'cves': [], 'status': v.get('Status'),
                                  'severity': sev_name(v.get('Severity')),
                                  'fixed': (v.get('FixedVersion') or '').strip()})
            hits[key]['cves'].append(v.get('VulnerabilityID'))
            if SEV_RANK[sev_name(v.get('Severity'))] > SEV_RANK[hits[key]['severity']]:
                hits[key]['severity'] = sev_name(v.get('Severity'))

    artifacts = defaultdict(list)
    for h in hits.values():
        artifacts[(h['group'], h['artifact'], h['current'])].append(h)

    # ---- family members, with their real Maven coordinates, per scope ----
    members = defaultdict(dict)    # (family, line, scope) -> {(g, a, v): member}
    left = defaultdict(set)        # (family, scope) -> vendor rebuilds that cannot move

    def add_member(fam, g, a, v, rel, hit=None):
        pool = members[(fam, release_line(g, a), scope_of(rel))]
        m = pool.setdefault((g, a, v), {'group': g, 'artifact': a, 'current': v,
                                        'paths': set(), 'hits': []})
        m['paths'].add(rel)
        if hit:
            m['hits'].append(hit)

    for h in hits.values():
        fam = family_of(h['group'])
        if fam and os.path.basename(h['path']) == '%s-%s.jar' % (h['artifact'], h['current']):
            add_member(fam, h['group'], h['artifact'], h['current'], h['path'], h)
    for dirpath, dirs, files in os.walk(root):
        for f in files:
            m = JAR_RE.match(f)
            if not m:
                continue
            art, ver = m.group('art'), m.group('ver')
            fam = family_of_artifact(art)
            if not fam:
                continue
            rel = os.path.relpath(os.path.join(dirpath, f), root)
            g = jar_group(os.path.join(dirpath, f), rel, art, fam)
            if g is None:
                continue
            if family_of(g) != fam:
                if g.startswith(VENDOR_GROUPS):
                    left[(fam, scope_of(rel))].add(
                        '%s:%s:%s - vendor rebuild, no upstream release to move it to' % (g, art, ver))
                continue
            add_member(fam, g, art, ver, rel)

    # ---- consumer picture (OSGi) ----
    exports = {}
    consumers = []
    for dirpath, _, files in os.walk(karaf_system):
        for f in files:
            if not f.endswith('.jar'):
                continue
            p = os.path.normpath(os.path.join(dirpath, f))
            man = manifest(p)
            if not man:
                continue
            bsn = man.get('Bundle-SymbolicName', '').split(';')[0]
            for pkg, ver in export_versions(man).items():
                exports.setdefault(pkg, (bsn, ver, p))
            for pkg, rng in imports_of(man):
                consumers.append((bsn, pkg, rng, p, man))

    pin_re = lambda g, a: re.compile(r'mvn:%s/%s/([0-9][^/<]*)(?:/([a-zA-Z][^/>]*))?' % (re.escape(g), re.escape(a)))

    def processing_block(group, artifact, target):
        pins = set()
        for pm in pin_re(group, artifact).findall(feature_text):
            pins.add(pm)
        classifier = next((c for _, c in sorted(pins) if c), None)
        ex = re.search(r'originalUri="mvn:%s/%s/\[([^],]+),([^)\]]+)\)"' % (re.escape(group), re.escape(artifact)), processing_text)
        lo = vtuple(ex.group(1)) if ex else min((vtuple(p) for p, _ in pins), default=(0,))
        suffix = ('/' + classifier) if classifier else ''
        return {
            'action': 'extend' if ex else 'add',
            'existing_originalUri': 'mvn:%s/%s/[%s,%s)' % (group, artifact, ex.group(1), ex.group(2)) if ex else None,
            'originalUri': 'mvn:%s/%s/[%s,%s)%s' % (group, artifact, vstr(lo), target, suffix),
            'replacement': 'mvn:%s/%s/%s%s' % (group, artifact, target, suffix),
            'mode': 'maven',
            'classifier': classifier,
            'feature_pins': sorted('%s%s' % (v, '/' + c if c else '') for v, c in pins),
        }

    def bundle_info(jar_abs, group, artifact):
        man = manifest(jar_abs) if os.path.exists(jar_abs) else None
        bsn = man.get('Bundle-SymbolicName', '').split(';')[0].strip() if man else ''
        norm = artifact.replace('-', '')
        native = bsn and (norm in bsn.replace('.', '').replace('-', '') or bsn.startswith(group))
        return bsn, bool(bsn) and not native

    def osgi_predict(moving, target):
        """moving: [(jar_abs, wrapped)] that all move to target together. Consumers
        that are themselves moving are skipped: they move with the group and are
        re-checked against their fetched manifests by the applier."""
        if args.no_osgi_check:
            return {'status': 'skipped'}
        skip = {j for j, _ in moving}
        viol, pre, checked = [], [], 0
        for jar, wrapped in moving:
            man = manifest(jar) if os.path.exists(jar) else None
            mine = export_versions(man) if man else {}
            for cb, pkg, rng, cp, cm in consumers:
                if pkg not in mine or cp in skip:     # OSGi ignores self-imports
                    continue
                checked += 1
                before = mine[pkg]
                after = before if wrapped else target  # rewrap preserves Export-Package verbatim
                if satisfies(rng, after):
                    continue
                row = {'consumer': cb, 'package': pkg, 'range': rng,
                       'exported_before': before, 'exported_after': after}
                (pre if not satisfies(rng, before) else viol).append(row)
        chk = {'status': 'fail' if viol else 'pass', 'consumer_imports_checked': checked}
        if viol:
            chk['violations'] = viol
        if pre:
            chk['pre_existing_violations'] = pre
        return chk

    def tidy(e):
        return {k: v for k, v in e.items() if v not in (None, [], '')}

    MEMBER_KEYS = ('mechanism', 'group', 'artifact', 'current', 'jump', 'severity', 'cves', 'paths',
                   'candidates', 'symbolic_name', 'wrapped', 'processing')
    families = []

    def make_family(name, target, rows, why_not=None, reason=None, extra=None):
        """Every entry of the patch file is a family: a set of members that move to
        one target together, switched by one lane. A standalone fix is a family of
        one. why_not: the family cannot be applied at all (reason says why)."""
        moving = []
        for e in rows:
            if target:
                e['jump'] = jump_kind(e['current'], target)
            if target and e['mechanism'] == 'karaf':
                jar_abs = os.path.normpath(os.path.join(root, e['paths'][0]))
                bsn, wrapped = bundle_info(jar_abs, e['group'], e['artifact'])
                e.update(symbolic_name=bsn or None, wrapped=wrapped,
                         processing=processing_block(e['group'], e['artifact'], target))
                moving.append((jar_abs, wrapped))
        n = len(rows)
        gjump = max((e['jump'] for e in rows), key=JUMP_RANK.get) if target else None
        chk = osgi_predict(moving, target) if moving else None
        jumps = [e for e in rows if e.get('jump', 'patch') != 'patch']
        if why_not:
            lane = Commented('manual', 'cannot be applied: %s' % why_not)
        else:
            if jumps and len(jumps) == n and len({e['current'] for e in jumps}) == 1:
                reason = '%s version jump (%s -> %s)%s' % (gjump, jumps[0]['current'], target,
                                                          ' for every member' if n > 1 else '')
            elif jumps:
                reason = '%s version jump to %s for %s' % (
                    gjump, target, ', '.join('%s %s' % (e['artifact'], e['current']) for e in jumps))
            elif chk and chk['status'] == 'fail':
                reason = 'import-range violation introduced by the move'
            many = {1: '', 2: ' both'}.get(n, ' all %d' % n)
            lane = (Commented('manual', 'set to auto to apply%s%s' % (many, ' together' if n > 1 else ''))
                    if reason else Commented('auto', 'set to manual to park%s' % many))
        members = []
        for e in rows:
            if gjump and e.get('jump') == gjump:
                e.pop('jump')                # only shown where it differs from the family's
            members.append(tidy({k: e.get(k) for k in MEMBER_KEYS}))
        families.append(tidy({'name': name, 'lane': lane, 'reason': reason,
                              'severity': max_sev(e.get('severity') for e in rows),
                              'target': target, 'jump': gjump, 'osgi_check': chk,
                              **(extra or {}), 'patches': members}))

    # ---- one family per non-family artifact; family artifacts only open a family ----
    groups = defaultdict(set)      # (family, line, scope, major) -> trigger targets
    already = []
    for (group, artifact, current), hs in sorted(artifacts.items()):
        statuses = {h['status'] for h in hs}
        fixed = next((h['fixed'] for h in hs if h['fixed']), '')
        paths = sorted({h['path'] for h in hs})
        sev = max_sev(h['severity'] for h in hs)
        cves = sorted({c for h in hs for c in h['cves']})
        name = '%s:%s %s' % (group, artifact, current)

        def row(mechanism, ps, **kw):
            return {'mechanism': mechanism, 'group': group, 'artifact': artifact, 'current': current,
                    'severity': sev, 'cves': cves, 'paths': ps, **kw}

        mech = 'karaf' if all(in_karaf_repo(p) for p in paths) else 'jar'
        if 'fixed' not in statuses or not fixed:
            make_family(name, None, [row(mech, paths)], why_not='no fixed version',
                        reason='no fixed version reported (unfixable)')
            continue
        candidates = sorted({c.strip() for c in fixed.split(',') if c.strip()}, key=vtuple)
        same_major = [c for c in candidates if vtuple(c)[0] == vtuple(current)[0]]
        if not same_major:
            make_family(name, None, [row(mech, paths, candidates=candidates)],
                        why_not='the fix is on another major line',
                        reason='fixed versions exist only on a different major line')
            continue
        target = same_major[0]
        if vtuple(target) <= vtuple(current):
            already.append({'group': group, 'artifact': artifact, 'current': current,
                            'paths': paths, 'reported_fixed': target})
            continue

        rest = paths
        if family_of(group):
            # plain artifact jars of a family open (or join) that family's entry;
            # only fat/renamed jars are handled on their own below
            mine = [p for p in paths if os.path.basename(p) == '%s-%s.jar' % (artifact, current)]
            for p in mine:
                groups[(family_of(group), release_line(group, artifact), scope_of(p),
                        vtuple(target)[0])].add(target)
            rest = [p for p in paths if p not in mine]

        karaf_paths = [p for p in rest if in_karaf_repo(p)]
        plain_ok = [p for p in rest if not in_karaf_repo(p)
                    and os.path.basename(p) == '%s-%s.jar' % (artifact, current)]
        fat = [p for p in rest if not in_karaf_repo(p) and p not in plain_ok]
        if karaf_paths:
            make_family(name + ' (karaf)', target, [row('karaf', karaf_paths, candidates=candidates)])
        if plain_ok:
            if group.startswith(VENDOR_GROUPS):
                make_family(name + ' (jars)', target, [row('jar', plain_ok, candidates=candidates)],
                            why_not='not on Maven Central', reason='vendor artifact; needs the vendor release')
            else:
                make_family(name + ' (jars)', target, [row('jar', plain_ok, candidates=candidates)])
        if fat:
            make_family(name + ' (inside other jars)', target, [row('jar', fat, candidates=candidates)],
                        why_not='not a plain artifact jar',
                        reason='the vulnerable classes are inside a differently-named jar (fat or renamed); '
                               'a file swap would drop everything else in it')

    # ---- library families: every member on the line, in the scope, moves together ----
    for (fam, line, scope, major), targets in sorted(groups.items()):
        target = max(targets, key=vtuple)
        rows, other_majors = [], []
        for (mg, ma, mv), m in sorted(members.get((fam, line, scope), {}).items()):
            if vtuple(mv)[0] != major:
                other_majors.append('%s:%s:%s' % (mg, ma, mv))
                continue
            if vtuple(mv) >= vtuple(target):
                continue
            rows.append({'mechanism': 'karaf' if scope == 'karaf' else 'jar',
                         'group': mg, 'artifact': ma, 'current': mv, 'paths': sorted(m['paths']),
                         'severity': max_sev(h['severity'] for h in m['hits']),
                         'cves': sorted({c for h in m['hits'] for c in h['cves']})})
        if rows:
            make_family('%s %s @ %s' % (fam, line, scope), target, rows,
                        extra={'other_majors': other_majors,
                               'left_in_place': sorted(left.get((fam, scope), ()))})

    # most severe first, so the HIGH/CRIT decisions are at the top of the file
    families.sort(key=lambda f: (-SEV_RANK.get(f.get('severity'), 0), f['name']))

    header = {'generator': 'generate-patch-lists', 'source': args.input,
              'source_sha256': hashlib.sha256(open(args.input, 'rb').read()).hexdigest(),
              'scan_artifact': report.get('ArtifactName'),
              'target_rule': 'smallest fixed version on the installed major line; only patch-level jumps '
                             'are applied unattended; a family moves to the highest target any member needs'}
    settings = {'levels': args.levels,                         # severity levels the applier patches
                'feature_processing': True,      # features.cfg line must be active or the file is ignored
                'strict_sha1': bool(args.strict)}  # default lenient: sha1 mismatch warns; --strict makes it fatal
    open(args.out, 'w').write(yaml_dump({'settings': settings, 'header': header, 'families': families}))

    auto = [f for f in families if plain(f['lane']) == 'auto']
    print('families    : %d (%d auto, %d manual; %d with more than one member)'
          % (len(families), len(auto), len(families) - len(auto),
             sum(len(f['patches']) > 1 for f in families)))
    print('levels      : %s' % args.levels)
    print('root        : %s (analysis only - not recorded, paths stay root-relative)' % root)
    if already:
        print('already at reported fixed version: %d entries' % len(already))
    for e in already:
        print('  SKIP %s/%s %s (reported fixed %s) %s' % (e['group'], e['artifact'], e['current'], e['reported_fixed'], e['paths'][0]))
    for f in families:
        if plain(f['lane']) == 'manual':
            print('REVIEW %s -> %s [%s] %s: %s' % (f['name'], f.get('target', '-'), f.get('jump', '-'),
                                                f.get('severity') or '-', f.get('reason', '')))
    if args.no_osgi_check:
        print('osgi check skipped: karaf moves are recorded unproven')
        return
    fails = [f for f in families if (f.get('osgi_check') or {}).get('status') == 'fail']
    for f in fails:
        print('%s %s -> %s : %s' % ('OSGI CHECK FAIL' if not args.no_osgi_fail else 'OSGI CHECK WARN',
                                    f['name'], f['target'], json.dumps(f['osgi_check']['violations'])))
    if fails and not args.no_osgi_fail:
        sys.exit(1)


if __name__ == '__main__':
    main()
